PORT=3000
NODE_ENV=development
CONTEXT_URL=/api/v1

# Swagger
SWAGGER_GEN_DOC_FILE=true

# JWT
JWT_ISSUER_PUBKEY='-----BEGIN PUBLIC KEY-----
-----END PUBLIC KEY-----'
JWT_ENABLE_CHECK=false
JWT_TOKEN_URL=

# Database
DATABASE_SYNC=false
DB_USERNAME=postgres
DB_PASSWORD=12345
DB_NAME=eu_ldt_starter
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres
SEQUELIZE_SEEDER_STORAGE=sequelize
SEQUELIZE_SEEDER_STORAGE_TABLE_NAME=SequelizeData
SEQUELIZE_MIGRATION_STORAGE=sequelize
SEQUELIZE_MIGRATION_STORAGE_TABLE_NAME=SequelizeData
DATABASE_URL=postgres://postgres:12345@localhost:5432/eu_ldt_starter
DB_MAX_POOL=100
DB_MIN_POOL=2
DB_IDLE_POOL=10000
DB_SCHEMA=example_schema


# Logger
LOGGER_TARGET=''
LOGGER_LEVEL=info

# Cypher
CYPHER_SECRET=mysecretkey
CYPHER_SALT=randomsalt
