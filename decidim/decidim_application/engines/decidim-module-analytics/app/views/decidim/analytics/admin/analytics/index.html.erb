<% add_decidim_page_title(t("decidim.admin.titles.analytics")) %>

<style>
  .analytics-iframe {
    border: 1px solid #ddd;
    border-radius: 4px;
    width: 100%;
    display: block;
  }

  #matomo-container {
    width: 100%;
    margin: 20px 0;
  }

  #matomo-error {
    margin: 20px 0;
    padding: 15px;
    border-left: 4px solid #f04124;
    background: #fdeaea;
    border-radius: 0 4px 4px 0;
  }
</style>

<div class="card" id="analytics">
  <div class="card-divider">
    <h2 class="card-title">
      <%= t "decidim.admin.titles.analytics" %>
    </h2>
  </div>

  <div class="card-section">
    <% if @server_address.present? && @site_id.present? && @token_auth.present? %>
      <div id="matomo-container">
        <iframe id="matomo-iframe"
                src="<%= @server_address %>/index.php?module=Widgetize&action=iframe&moduleToWidgetize=Dashboard&actionToWidgetize=index&idSite=<%= @site_id %>&period=month&date=today&token_auth=<%= @token_auth %>"
                frameborder="0"
                width="100%"
                height="1000px"
                class="analytics-iframe">
        </iframe>

        <div id="matomo-error" style="display: none;" class="callout alert">
          <p><strong><%= t("decidim.analytics.admin.unable_to_load_matomo") %></strong></p>
          <p><%= t("decidim.analytics.admin.please_check") %></p>
          <ul>
            <li><%= t("decidim.analytics.admin.matomo_server_running") %> <code><%= @server_address %></code></li>
            <li><%= t("decidim.analytics.admin.site_id") %> <code><%= @site_id %></code> <%= t("decidim.analytics.admin.site_id_exists") %></li>
            <li><%= t("decidim.analytics.admin.token_permissions") %></li>
          </ul>
          <p><%= t("decidim.analytics.admin.try_accessing") %> <a href="<%= @server_address %>" target="_blank"><%= t("decidim.analytics.admin.matomo_directly") %></a> <%= t("decidim.analytics.admin.verify_configuration") %></p>
        </div>
      </div>

      <script>
        document.getElementById('matomo-iframe').addEventListener('load', function() {
          console.log('Matomo widget loaded successfully');

          // Hide error message if shown
          var errorDiv = document.getElementById('matomo-error');
          if (errorDiv) {
            errorDiv.style.display = 'none';
          }
        });

        document.getElementById('matomo-iframe').addEventListener('error', function() {
          console.error('Failed to load Matomo widget');

          var errorDiv = document.getElementById('matomo-error');
          if (errorDiv) {
            errorDiv.style.display = 'block';
          }
        });
      </script>
    <% else %>
      <div class="callout warning">
        <p><%= t("decidim.analytics.admin.missing_configuration") %></p>
        <p><%= t("decidim.analytics.admin.missing_configuration_values") %></p>
        <ul>
          <% unless @server_address.present? %><li><%= t("decidim.analytics.admin.server_address") %></li><% end %>
          <% unless @site_id.present? %><li><%= t("decidim.analytics.admin.site_id") %></li><% end %>
          <% unless @token_auth.present? %><li><%= t("decidim.analytics.admin.authentication_token") %></li><% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
