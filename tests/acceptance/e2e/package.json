{
	"name": "e2e",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"test:ci": "cross-env ENV=ci npx playwright test --workers=1",
		"test:dev": "cross-env ENV=development npx playwright test --workers=1",
		"test:prod": "cross-env ENV=production npx playwright test --workers=1",
		"test-ui": "playwright test --ui --workers=1",
		"test-ui-port0:ci": "cross-env ENV=ci npx playwright test --ui-port=0 --workers=1",
		"test-ui-port0:dev": "cross-env ENV=development npx playwright test --ui-port=0 --workers=1",
		"test-ui-port0:prod": "cross-env ENV=production npx playwright test --ui-port=0 --workers=1",
		"setup:auth": "set FE_BASE_URL=http://localhost:3000 && npx playwright test --project user-setup --project admin-setup",
		"report": "playwright show-report"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"devDependencies": {
		"@axe-core/playwright": "^4.10.1",
		"@playwright/test": "^1.52.0",
		"@types/node": "^22.15.21",
		"cross-env": "^7.0.3",
		"dotenv": "^16.4.7"
	}
}
