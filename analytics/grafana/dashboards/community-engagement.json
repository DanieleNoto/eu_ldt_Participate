					"format": "table",
					"rawQuery": true,
					"rawSql": "SELECT 'Comments' as activity_type, COUNT(*) as value FROM decidim_comments_comments WHERE deleted_at IS NULL\nUNION ALL\nSELECT 'Proposals' as activity_type, COUNT(*) as value FROM decidim_proposals_proposals WHERE deleted_at IS NULL\nUNION ALL\nSELECT 'Endorsements' as activity_type, COUNT(*) as value FROM decidim_endorsements\nUNION ALL\nSELECT 'Follows' as activity_type, COUNT(*) as value FROM decidim_follows;",
					"refId": "A"
