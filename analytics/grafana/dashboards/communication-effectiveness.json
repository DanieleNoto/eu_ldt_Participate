			"targets": [
				{
					"datasource": {
						"type": "postgres",
						"uid": "decidim_postgres"
					},
					"editorMode": "code",
					"format": "table",
					"rawQuery": true,
					"rawSql": "SELECT \n  p.id,\n  COALESCE(p.title->>'en', p.title->>'it', p.title->>'fr', p.title->>'de', p.title->>'es', p.title::text) as title,\n  p.created_at,\n  COUNT(DISTINCT c.id) as comment_count,\n  COUNT(DISTINCT e.id) as endorsement_count,\n  ROUND(\n    (COUNT(DISTINCT c.id) + COUNT(DISTINCT e.id)) / \n    GREATEST(EXTRACT(days FROM NOW() - p.created_at), 1), 2\n  ) as engagement_rate\nFROM decidim_proposals_proposals p\nLEFT JOIN decidim_comments_comments c ON p.id = c.decidim_commentable_id AND c.decidim_commentable_type = 'Decidim::Proposals::Proposal' AND c.deleted_at IS NULL\nLEFT JOIN decidim_endorsements e ON p.id = e.resource_id AND e.resource_type = 'Decidim::Proposals::Proposal'\nWHERE p.deleted_at IS NULL AND p.created_at >= NOW() - INTERVAL '30 days'\nGROUP BY p.id, p.title, p.created_at\nORDER BY engagement_rate DESC\nLIMIT 10;",
					"refId": "A"
				}
			],
			"title": "Most Engaging Recent Proposals",
			"type": "table"
		},
