					"editorMode": "code",
					"format": "table",
					"rawQuery": true,
					"rawSql": "SELECT \n  CASE \n    WHEN state.title->>'en' IS NOT NULL THEN state.title->>'en'\n    WHEN state.title->>'it' IS NOT NULL THEN state.title->>'it'\n    WHEN state.title->>'fr' IS NOT NULL THEN state.title->>'fr'\n    ELSE 'Unknown'\n  END as proposal_state,\n  COUNT(*) as value\nFROM decidim_proposals_proposals p\nLEFT JOIN decidim_proposals_proposal_states state ON p.decidim_proposals_proposal_state_id = state.id\nWHERE p.deleted_at IS NULL\nGROUP BY \n  CASE \n    WHEN state.title->>'en' IS NOT NULL THEN state.title->>'en'\n    WHEN state.title->>'it' IS NOT NULL THEN state.title->>'it'\n    WHEN state.title->>'fr' IS NOT NULL THEN state.title->>'fr'\n    ELSE 'Unknown'\n  END\nORDER BY value DESC;",
