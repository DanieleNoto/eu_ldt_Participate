<div class="md:flex grow w-full ldt-admin-header py-2 pl-4 pr-0 text-center items-center custom-admin-header">
  <div class='flex grow gap-4 justify-between items-center'>
    <div id="ldt-logo">
      <%= link_to decidim.root_path do %>
        <%= image_pack_tag('media/images/logo.svg', alt: 'LDT', height: 28) %>
      <% end %>
    </div>
    <!-- Tools Button -->
    <div class="flex items-center">
      <div class="relative flex">
        <button id="tools-dropdown-button" class="tools-button flex items-center" type="button">
          <%= image_pack_tag('media/images/tools.svg', alt: t("decidim.admin_header.tools"), id: "tools-icon", class: "tools-icon", height: 20) %>
          <span class="tools-text"><%= t("decidim.admin_header.tools") %></span>
        </button>
        <div id="tools-dropdown" class="tools-dropdown hidden">
          <div class="loading-message">Loading...</div>
        </div>
      </div>
      <!-- Help Button -->
      <% if ENV['HELP_URL'].present? %>
        <a href="<%= ENV['HELP_URL'] %>" id="help-link" target="_blank" rel="noopener noreferrer nofollow" class="help-button" title="<%= t("decidim.admin_header.help") %>">
          <%= image_pack_tag('media/images/help.svg', alt: t("decidim.admin_header.help"), id: "help-icon", height: 24) %>
        </a>
      <% end %>
      <!-- User Button with Dropdown -->
      <div class="relative flex">
        <button id="user-dropdown-button" class="user-button" type="button" title="<%= t("decidim.admin_header.user_menu") %>">
          <%= image_pack_tag('media/images/user.svg', alt: t("decidim.admin_header.user_menu"), id: "user-icon", height: 24) %>
        </button>
        <div id="user-dropdown" class="user-dropdown hidden">
          <% if respond_to?(:decidim) && decidim.respond_to?(:destroy_user_session_path) %>
            <%= link_to decidim.destroy_user_session_path, method: :delete, data: { turbo: true, turbo_method: :delete }, class: "logout-link" do %>
              <svg class="logout-icon" focusable="false" aria-hidden="true" viewBox="0 0 24 24">
                <path d="m17 8-1.41 1.41L17.17 11H9v2h8.17l-1.58 1.58L17 16l4-4zM5 5h7V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h7v-2H5z"></path>
              </svg>
              <span><%= t("decidim.admin_header.log_out") %></span>
            <% end %>
          <% else %>
            <!-- Logout link not available in this context -->
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<div style="height: 56px; background-color: #F2F4F5; padding-left: 32px; padding-right: 32px; display: flex; align-items: center; gap: 8px;">
  <%= image_pack_tag('media/images/participate-logo.svg', alt: 'Participate', width: 24, height: 24) %>
  <span style="font-weight: 600; font-size: 16px; line-height: 24px; letter-spacing: 0.15px;">Participate</span>
</div>
