<% add_decidim_page_title(t(".title")) %>

<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
      <div class="flex align-middle gap-x-4 ml-auto">
        <% if allowed_to? :create, :ldt_use_case_scenario %>
          <%= link_to t(".associate_experiments"), 
              "/admin/participatory_processes/#{current_participatory_space.slug}/components/#{current_component.id}/manage/ldt_use_case_scenarios/new",
              class: "button button__sm button__secondary" %>
        <% end %>
        <%= render partial: "decidim/admin/components/resource_action" %>
      </div>
    </h1>
  </div>

  <% if @use_case_scenarios.any? %>
    <div class="table-stacked">
      <table class="table-list w-full" style="width: 100%;">
        <thead>
          <tr>
            <th><%= t(".association_name") %></th>
            <th><%= t(".associated_experiment_results") %></th>
            <th><%= t(".actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @use_case_scenarios.each do |scenario| %>
            <tr data-scenario-id="<%= scenario.id %>">
              <td class="!text-left" data-label="<%= t(".scenario_name") %>">
                <strong><%= scenario.name %></strong>
              </td>
              <td data-label="<%= t(".experiment_id") %>">
                <%= scenario.experiment_id %>
              </td>
              
              <td class="table-list__actions" data-label="<%= t(".actions") %>">
                <div class="flex gap-x-2">
                  <% if allowed_to? :destroy, :ldt_use_case_scenario %>
                    <p class="inline-block has-tip">
                      <a class="action-icon action-icon--delete"
                         href="/admin/participatory_processes/#{current_participatory_space.slug}/components/#{current_component.id}/manage/ldt_use_case_scenarios/#{scenario.id}"
                         data-method="delete"
                         rel="nofollow"
                         title="<%= t('.delete') %>"
                         data-confirm="<%= t('decidim.admin.actions.confirm_delete') %>">
                        <span class="has-tip">
                          <svg width="1em" height="1em" role="img" aria-hidden="true" aria-label="<%= t('.delete') %>">
                            <use href="/decidim-packs/media/images/remixicon.symbol-e643e553623ffcd49f94.svg#ri-delete-bin-line"></use>
                          </svg>
                        </span>
                      </a>
                    </p>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <p><%= t(".no_scenarios") %></p>
    </div>
  <% end %>
</div>

