			},
			"targets": [
				{
					"datasource": {
						"type": "postgres",
						"uid": "decidim_postgres"
					},
					"editorMode": "code",
					"format": "table",
					"rawQuery": true,
					"rawSql": "SELECT \n  pp.slug as process_slug,\n  COALESCE(pp.title->>'en', pp.title->>'it', pp.title->>'fr', pp.title->>'de', pp.title->>'es', pp.title::text) as process_title,\n  COUNT(DISTINCT p.id) as proposals_count,\n  COUNT(DISTINCT c.id) as comments_count,\n  COUNT(DISTINCT e.id) as endorsements_count,\n  (COUNT(DISTINCT p.id) + COUNT(DISTINCT c.id) + COUNT(DISTINCT e.id)) as total_engagement\nFROM decidim_participatory_processes pp\nLEFT JOIN decidim_components comp ON pp.id = comp.decidim_participatory_space_id AND comp.decidim_participatory_space_type = 'Decidim::ParticipatoryProcess'\nLEFT JOIN decidim_proposals_proposals p ON comp.id = p.decidim_component_id AND p.deleted_at IS NULL\nLEFT JOIN decidim_comments_comments c ON (p.id = c.decidim_commentable_id AND c.decidim_commentable_type = 'Decidim::Proposals::Proposal') AND c.deleted_at IS NULL\nLEFT JOIN decidim_endorsements e ON p.id = e.resource_id AND e.resource_type = 'Decidim::Proposals::Proposal'\nWHERE pp.deleted_at IS NULL\nGROUP BY pp.id, pp.slug, pp.title\nORDER BY total_engagement DESC\nLIMIT 10;",
					"refId": "A"
				}
			],
			"title": "Most Engaging Processes",
			"type": "table"
		}
