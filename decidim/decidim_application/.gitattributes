# Set default line ending behavior
* text=auto

# Explicitly declare text files you want to always be normalized
*.rb text
*.js text
*.ts text
*.jsx text
*.tsx text
*.css text
*.scss text
*.sass text
*.html text
*.erb text
*.yml text
*.yaml text
*.json text
*.md text
*.txt text

# Declare files that will always have LF line endings on checkout
*.sh text eol=lf
bin/* text eol=lf
docker-entrypoint.sh export-ignore diff=sh
shakapacker-entrypoint.sh export-ignore diff=sh

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
