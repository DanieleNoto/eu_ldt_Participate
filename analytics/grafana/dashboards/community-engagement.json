					"editorMode": "code",
					"format": "table",
					"rawQuery": true,
					"rawSql": "SELECT ROUND(\n  (COUNT(DISTINCT CASE WHEN c.created_at >= NOW() - INTERVAL '30 days' THEN c.decidim_author_id END) * 100.0) / \n  NULLIF(COUNT(DISTINCT u.id), 0), 2\n) as value\nFROM decidim_users u\nLEFT JOIN decidim_comments_comments c ON u.id = c.decidim_author_id AND c.decidim_author_type = 'Decidim::User' AND c.deleted_at IS NULL\nWHERE u.deleted_at IS NULL AND u.type = 'Decidim::User';",
					"refId": "A"
				}
			],
			"title": "Active Users Rate (%)",
			"type": "stat"
