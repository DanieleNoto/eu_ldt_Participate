<tr data-experiment-id="<%= experiment[:id] %>">
  <td data-label="<%= t("models.experiment.fields.id", scope: "decidim.ldt_use_case_scenarios") %>">
    <%= experiment[:id] %>
  </td>
  <td class="!text-left" data-label="<%= t("models.experiment.fields.name", scope: "decidim.ldt_use_case_scenarios") %>">
    <strong><%= experiment[:name] %></strong>
  </td>
  <td data-label="<%= t("models.experiment.fields.description", scope: "decidim.ldt_use_case_scenarios") %>">
    <%= truncate(experiment[:description], length: 100) %>
  </td>
  <td class="table-list__actions" data-label="<%= t("actions.title", scope: "decidim.ldt_use_case_scenarios") %>">
    <button type="button" class="button button__sm button__secondary select-experiment" data-experiment='<%= experiment.to_json %>'>
      <%= t(".select", scope: "decidim.ldt_use_case_scenarios.admin.ldt_use_case_scenarios") %>
    </button>
  </td>
</tr>
