FROM node:18-alpine

# Install curl for health checks and postgresql-client for database initialization
RUN apk add --no-cache curl postgresql-client

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install ALL dependencies (including dev dependencies for development)
RUN npm ci

# Copy source code
COPY . .

# Copy initialization script
COPY scripts/init-db.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/init-db.sh

RUN addgroup -S app && adduser -S -G app app

RUN chown -R app:app /app && chown app:app /usr/local/bin/init-db.sh

# Run the container as the non-root user from here on
USER app

# Expose the port
EXPOSE 3002

# Use initialization script as entrypoint
ENTRYPOINT ["/usr/local/bin/init-db.sh"]

# For development, use nodemon with TypeScript
CMD ["npm", "run", "dev"]