					"rawQuery": true,
					"rawSql": "SELECT ROUND(\n  (COUNT(CASE WHEN response_time <= 24 THEN 1 END) * 100.0) / \n  NULLIF(COUNT(*), 0), 2\n) as value\nFROM (\n  SELECT \n    p.id,\n    EXTRACT(epoch FROM (MIN(c.created_at) - p.created_at)) / 3600 as response_time\n  FROM decidim_proposals_proposals p\n  LEFT JOIN decidim_comments_comments c ON p.id = c.decidim_commentable_id \n    AND c.decidim_commentable_type = 'Decidim::Proposals::Proposal' \n    AND c.deleted_at IS NULL\n  WHERE p.deleted_at IS NULL \n    AND p.created_at >= NOW() - INTERVAL '30 days'\n    AND c.id IS NOT NULL\n  GROUP BY p.id, p.created_at\n) as response_times;",
					"refId": "A"
				}
			],
			"title": "24h Response Rate (%)",
			"type": "stat"
		}
	],
