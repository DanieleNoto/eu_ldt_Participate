<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <%= tag :meta, "http-equiv": "Content-Type", content: "text/html; charset=utf-8" %>
    <%= tag :meta, name: "viewport", content: "width=device-width" %>
    <%= stylesheet_pack_tag "decidim_email" %>
    <style type="text/css">
      a {
        color: <%= @organization.colors["primary"] || '#004494' %> !important;
      }
      .decidim-bar a,
      .cityhall-bar a {
        color: #ffffff !important;
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <table width="832" cellpadding="0" cellspacing="0" style="background-color: #ffffff; margin: 0 auto; max-width: 832px;">
      <% if content_for?(:see_on_website) %>
        <tr>
          <td style="padding: 10px 80px; text-align: right; font-size: 12px; color: #666666;">
            <%= yield(:see_on_website) %>
          </td>
        </tr>
      <% end %>
      
      <!-- Header -->
      <tr>
        <td style="background-color: #004494; height: 100px; padding: 0;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td style="padding: 27px 80px; text-align: left;">
                <% if @organization.official_img_footer.present? %>
                  <%= link_to decidim.root_url(host: @organization.host) do %>
                    <%= image_tag @organization.attached_uploader(:official_img_footer).path, alt: organization_name(@organization), height: "45", style: "height: 45px; width: auto; display: block;" %>
                  <% end %>
                <% else %>
                  <%= link_to organization_name(@organization).html_safe, decidim.root_url(host: @organization.host), style: "color: #ffffff; text-decoration: none; font-size: 24px; font-weight: bold;" %>
                <% end %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      
      <!-- Content -->
      <tr>
        <td style="background-color: #ffffff; padding: 40px 80px;">
          <div style="font-family: 'Open Sans', Arial, sans-serif; font-size: 18px; line-height: 1.4; color: #000000;">
            <%= yield %>
          </div>
        </td>
      </tr>
      
      <!-- Footer -->
      <tr>
        <td style="background-color: #004494; height: 63px; padding: 0;">
          <table width="100%" cellpadding="0" cellspacing="0">
            <tr>
              <td style="text-align: center; vertical-align: middle; height: 63px;">
                <% if @custom_url_for_mail_root.present? %>
                  <%= link_to "#{t('decidim.mailer.cta_open_toolbox')}".html_safe, @custom_url_for_mail_root, style: "color: #ffffff !important; text-decoration: underline; font-family: 'Open Sans', Arial, sans-serif; font-size: 20px; font-weight: bold;" %>
                <% else %>
                  <%= link_to "#{t('decidim.mailer.cta_open_toolbox')}".html_safe, decidim.root_url(host: @organization.host), style: "color: #ffffff !important; text-decoration: underline; font-family: 'Open Sans', Arial, sans-serif; font-size: 20px; font-weight: bold;" %>
                <% end %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
      
      <% if content_for?(:note) or content_for?(:unsubscribe) %>
        <tr>
          <td style="padding: 20px 80px; text-align: center; font-size: 12px; color: #666666;">
            <%= yield(:note) if content_for?(:note) %>
            <%= yield(:unsubscribe) if content_for?(:unsubscribe) %>
          </td>
        </tr>
      <% end %>
      
      <!-- Footer note -->
      <tr>
        <td style="padding: 20px 80px; text-align: center; font-size: 12px; color: #666666;">
          <%= t("decidim.newsletter_mailer.newsletter.no_reply_notice", 
               privacy_policy_url: decidim.page_url(Decidim::StaticPage.find_by(slug: "terms-and-conditions", organization: @organization)&.slug || "terms-and-conditions", host: @organization.host),
               notification_preferences_url: decidim.notifications_settings_url(host: @organization.host)).html_safe %>
        </td>
      </tr>
    </table>
  </body>
</html>
