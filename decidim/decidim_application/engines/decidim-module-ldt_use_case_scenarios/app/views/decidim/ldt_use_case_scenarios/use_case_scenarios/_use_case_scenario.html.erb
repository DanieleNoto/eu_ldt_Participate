<%= link_to use_case_scenario_path(use_case_scenario), class: "card__list", id: "use_case_scenario_#{use_case_scenario.id}" do %>
  <div class="card__list-content">
    <div class="h4 card__list-title">
      <%= use_case_scenario.name %>
    </div>

    <% if use_case_scenario.experiment_data.present? && use_case_scenario.experiment_data['description'].present? %>
      <div class="card__list-text">
        <div class="rich-text-display">
          <%= truncate(use_case_scenario.experiment_data['description'], length: 200, separator: ' ') %>
        </div>
      </div>
    <% end %>

    <div class="card__list-metadata">
      <% if use_case_scenario.experiment_data&.dig('id').present? %>
        <div>
          <svg width="1em" height="1em" role="img" aria-hidden="true">
            <use href="/decidim-packs/media/images/remixicon.symbol-e643e553623ffcd49f94.svg#ri-flask-line"></use>
          </svg>
          <%= truncate(use_case_scenario.experiment_data['id'], length: 35) %>
        </div>
      <% end %>

      <div>
        <svg width="1em" height="1em" role="img" aria-hidden="true">
          <use href="/decidim-packs/media/images/remixicon.symbol-e643e553623ffcd49f94.svg#ri-calendar-todo-line"></use>
        </svg>
        <%= l use_case_scenario.created_at, format: :decidim_short %>
      </div>
    </div>
  </div>
<% end %>
