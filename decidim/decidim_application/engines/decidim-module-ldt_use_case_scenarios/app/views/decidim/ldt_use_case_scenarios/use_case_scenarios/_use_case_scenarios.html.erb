<% if @use_case_scenarios.blank? %>
  <div class="callout warning">
    <p><%= t(".empty") %></p>
  </div>
<% else %>
  <h2 class="h5 md:h3 decorator">
    <%= t("decidim.ldt_use_case_scenarios.use_case_scenarios.index.count", count: @use_case_scenarios.total_count) %>
  </h2>

  <% @use_case_scenarios.each do |use_case_scenario| %>
    <%= render partial: "decidim/ldt_use_case_scenarios/use_case_scenarios/use_case_scenario", locals: { use_case_scenario: use_case_scenario } %>
  <% end %>

  <%= decidim_paginate @use_case_scenarios %>
<% end %>
