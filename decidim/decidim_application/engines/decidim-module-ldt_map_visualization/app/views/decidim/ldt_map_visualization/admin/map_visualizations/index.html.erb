<% add_decidim_page_title(t(".title")) %>

<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
      <div class="flex align-middle gap-x-4 ml-auto">
        <%= link_to t(".new"), new_admin_map_visualization_path, class: "button button__sm button__secondary" if allowed_to? :create, :map_visualization %>
        <%= render partial: "decidim/admin/components/resource_action" %>
      </div>
    </h1>
  </div>

  <% if @map_visualizations.any? %>
    <div class="table-stacked">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th><%= t(".actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @map_visualizations.each do |map_viz| %>
            <tr>
              <td><%= map_viz.name %></td>
              <td>
                <div class="flex gap-x-2">
                  <%= link_to t(".edit"), edit_admin_map_visualization_path(map_viz), class: "button button__xs button__secondary" if allowed_to? :update, :map_visualization %>
                  <%= link_to t(".delete"), admin_map_visualization_path(map_viz), method: :delete, data: { confirm: t("decidim.admin.actions.confirm_delete") }, class: "button button__xs button__alert" if allowed_to? :destroy, :map_visualization %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <p><%= t(".no_maps") %></p>
    </div>
  <% end %>
</div>

