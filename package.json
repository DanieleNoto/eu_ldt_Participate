{
	"name": "euldt-participate-monorepo",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"format": "prettier \"**/*.{cjs,js,json,md,ts}\" --ignore-path ./.eslintignore --write",
		"format:check": "prettier --check .",
		"format:git:staged": "pretty-quick --pattern \"**/*.{cjs,html,js,json,md,ts}\" --ignore-path ./.eslintignore --staged",
		"lint": "eslint --flag unstable_config_lookup_from_file .",
		"lint:ci": "lint-staged",
		"prepare:commit-msg-unix": "exec < /dev/tty && git cz --hook || true",
		"prepare:commit-msg-win": "utils\\commit\\utils\\prepare-commit-msg",
		"prepare": "husky && husky install"
	},
	"dependencies": {},
	"devDependencies": {
		"@commitlint/cli": "^19.7.1",
		"@commitlint/config-conventional": "^19.7.1",
		"@eslint/compat": "^1.2.6",
		"@eslint/js": "^9.20.0",
		"@typescript-eslint/eslint-plugin": "^8.23.0",
		"@typescript-eslint/parser": "^8.23.0",
		"commitizen": "^4.2.5",
		"cz-conventional-changelog": "^3.3.0",
		"dotenv": "^16.4.7",
		"dotenv-cli": "^8.0.0",
		"eslint": "^9.20.0",
		"eslint-plugin-import": "^2.27.5",
		"eslint-plugin-prefer-arrow": "latest",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"husky": "^8.0.0",
		"lint-staged": "^15.4.3",
		"prettier": "^3.5.0",
		"pretty-quick": "^4.0.0",
		"typescript-eslint": "^8.24.0"
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	}
}
