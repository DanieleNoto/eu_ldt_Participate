PORT=3000
NODE_ENV=development
CONTEXT_URL=/api/v1

# CORS
CORS_ORIGINS=http://localhost:5001,http://localhost:3000

# JWT
JWT_ISSUER_PUBKEY='-----BEGIN PUBLIC KEY-----
-----END PUBLIC KEY-----'
JWT_ENABLE_CHECK=false
JWT_TOKEN_URL=

# Database
DATABASE_URL=
DATABASE_STORAGE=":memory:"
DB_MAX_POOL=100
DB_MIN_POOL=2
DB_IDLE_POOL=10000
DB_SCHEMA=example_schema
DB_DIALECT=sqlite
SEQUELIZE_SEEDER_STORAGE=sequelize
SEQUELIZE_SEEDER_STORAGE_TABLE_NAME=SequelizeData
SEQUELIZE_MIGRATION_STORAGE=sequelize
SEQUELIZE_MIGRATION_STORAGE_TABLE_NAME=SequelizeData

# Logger
LOGGER_TARGET=''
LOGGER_LEVEL=warn

# Cypher 
CYPHER_SECRET=mysecretkey
CYPHER_SALT=randomsalt

# Rate Limit
RATE_LIMIT_TIME_WINDOW="1 minute"
RATE_LIMIT_MAX=50000

# Underpressure
MAX_EVENT_LOOP_USE=1        # 1 means 100% utilization allowed
MAX_HEAP_USED_BYTES=1073741824   # 1 GB 
EVENT_LOOP_DELAY=10000      # 10,000 ms 
MAX_RSS_BYTES=2147483648   # 2 GB
