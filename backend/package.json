{
	"name": "euldt-participate-chatbot-be",
	"version": "1.0.0",
	"description": "BE Project of EU LDT Participate chatbot",
	"main": "build/src/server.js",
	"scripts": {
		"build": "tsc -p tsconfig.json && npm run copy-assets",
		"copy-assets": "node scripts/copy-assets.js",
		"dev": "nodemon --watch src src/server.ts",
		"start": "node build/src/server.js",
		"test": "jest --runInBand --verbose",
		"test-debug": "jest --runInBand --verbose --debug",
		"locust": "locust --config locust/locust.conf",
		"test:load": "npm run dev --env .env.test & npm run locust",
		"type-check": "tsc",
		"seed": "sequelize-cli --options-path=.sequelizerc.js db:seed:all",
		"migrate": "sequelize-cli --options-path=.sequelizerc.js db:migrate",
		"seed:undo": "sequelize-cli --options-path=.sequelizerc.js db:seed:undo:all",
		"seed:generate": "sequelize-cli --options-path=.sequelizerc.js seed:generate --name"
	},
	"dependencies": {
		"@faker-js/faker": "^9.9.0",
		"@fastify/autoload": "^6.3.1",
		"@fastify/cors": "^11.1.0",
		"@fastify/formbody": "^8.0.2",
		"@fastify/helmet": "^13.0.1",
		"@fastify/jwt": "^10.0.0",
		"@fastify/middie": "^9.2.0",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/request-context": "^6.2.1",
		"@fastify/sensible": "^6.0.3",
		"@fastify/swagger": "^9.5.1",
		"@fastify/swagger-ui": "^5.2.3",
		"@fastify/under-pressure": "^9.0.3",
		"@types/axios": "^0.9.36",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.20",
		"axios": "^1.16.0",
		"bcryptjs": "^3.0.2",
		"body-parser": "^2.2.2",
		"dotenv": "^17.2.1",
		"fastify": "^5.8.3",
		"fastify-cli": "^7.4.0",
		"fastify-plugin": "^5.0.1",
		"fastify-type-provider-zod": "^5.0.3",
		"handlebars": "^4.7.8",
		"i18next": "^25.3.4",
		"i18next-fs-backend": "^2.6.0",
		"i18next-http-middleware": "^3.8.0",
		"ioredis": "^5.7.0",
		"jest": "^30.2.0",
		"joi": "^18.0.0",
		"jsdom": "^26.1.0",
		"nodemailer": "^8.0.4",
		"pg": "^8.16.3",
		"pg-hstore": "^2.3.4",
		"pino": "^9.8.0",
		"puppeteer": "^24.30.0",
		"reflect-metadata": "^0.2.2",
		"sequelize": "^6.37.7",
		"sequelize-typescript": "^2.1.6",
		"ts-jest": "^29.4.1",
		"umzug": "^3.8.2",
		"undici": "^7.24.0",
		"zod": "^4.0.17"
	},
	"devDependencies": {
		"@types/jsdom": "^21.1.7",
		"@types/node": "^24.2.1",
		"@types/nodemailer": "^6.4.19",
		"@types/validator": "^13.15.2",
		"husky": "^9.1.7",
		"jest-html-reporter": "^4.3.0",
		"jest-junit": "^16.0.0",
		"nodemon": "^3.1.10",
		"pino-pretty": "^13.1.1",
		"sequelize-cli": "^6.6.3",
		"sqlite3": "^5.1.7",
		"ts-node": "^10.9.2",
		"typescript": "~5.9.2",
		"zocker": "^2.2.2"
	},
	"overrides": {
		"ajv": "^8.18.0",
		"glob": "^9.3.5",
		"tar": "^7.5.8"
	}
}
