# --- Decidim main application ---
# Hostname or IP of the Postgres DB container
DATABASE_HOST=db
# Username for Postgres DB
DATABASE_USERNAME=postgres
# Password for Postgres DB
DATABASE_PASSWORD=postgres
# Database name for Decidim
DATABASE_NAME=decidim_application_development
# Database port
DB_PORT=5432

# Full database connection string used by the backend service
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@db:5432/decidim_application_development

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# Rails secret key base (change in production!)
SECRET_KEY_BASE=insecure_key_base

# Force HTTPS (set to true in production)
DECIDIM_FORCE_SSL=false

# Rails environment (development, production, test)
RAILS_ENV=development
# Node.js environment
NODE_ENV=development

# Email sender for Decidim notifications
DECIDIM_MAILER_SENDER=changeme@example.org

# --- SMTP configuration for Decidim ---
# SMTP server address (e.g. smtp.gmail.com)
SMTP_ADDRESS=smtp.example.com
# SMTP server port (e.g. 587)
SMTP_PORT=587
# SMTP username
SMTP_USER_NAME=your_smtp_username
# SMTP password
SMTP_PASSWORD=your_smtp_password
# SMTP domain (e.g. example.com)
SMTP_DOMAIN=example.com
# SMTP authentication type (plain, login, cram_md5)
SMTP_AUTHENTICATION=plain
# Enable STARTTLS (true/false)
SMTP_ENABLE_STARTTLS_AUTO=true
# OpenSSL verify mode (optional, e.g. none)
SMTP_OPENSSL_VERIFY_MODE=

# --- Chatbot Configuration ---
# Enable/disable chatbot widget injection
CHATBOT_ENABLED=true
# Base URL where chatbot frontend is hosted (must be accessible from user's browser)
# IMPORTANT: This URL is used in the browser, not on the server!
# Development (accessing from host): http://localhost:5001
# Development (using Docker network): Use actual domain or localhost
# Production: https://chatbot.your-domain.com
CHATBOT_URL=http://localhost:5001
# Chatbot backend API URL (for CSP connect-src directive)
# Development: http://localhost:3002
# Docker: http://backend:3002
# Production: https://api.your-domain.com
CHATBOT_BACKEND_URL=http://localhost:3002
# Optional cache-busting token for static assets (recommended for production)
# In production, set this to your git commit SHA or build timestamp
CHATBOT_ASSET_VERSION=1.0.0

# ActiveJob queue adapter (async for dev, sidekiq for prod)
QUEUE_ADAPTER=async

# --- Keycloak OAuth ---
# Keycloak client ID
OMNIAUTH_KEYCLOAK_CLIENT_ID=xxxx
# Keycloak client secret
OMNIAUTH_KEYCLOAK_CLIENT_SECRET=xxxx
# Keycloak server URL
OMNIAUTH_KEYCLOAK_SITE=xxx
# Keycloak realm name
OMNIAUTH_KEYCLOAK_REALM=xxx
# Set to true if you have SSL verification issues in development
KEYCLOAK_DISABLE_SSL_VERIFY=false

# --- Grafana ---
# Grafana admin user credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Grafana Keycloak OAuth2 Authentication ---
# Enable generic OAuth authentication
GF_AUTH_GENERIC_OAUTH_ENABLED=true
# Name displayed on the login button
GF_AUTH_GENERIC_OAUTH_NAME=Keycloak-OAuth
# Allow users to sign up automatically
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
# Keycloak client ID for Grafana (you may need to create a separate client for Grafana)
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=xxxx
# Keycloak client secret for Grafana (this is the client secret generated by Keycloak for the grafana-oauth client)
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=xxxx
# OAuth scopes
GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile offline_access roles
# User attribute mappings
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=username
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=full_name
# Keycloak OAuth URLs (using existing Keycloak configuration)
GF_AUTH_GENERIC_OAUTH_AUTH_URL=xxxxx
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=xxxx
GF_AUTH_GENERIC_OAUTH_API_URL=xxxxx
# Role mapping (maps Keycloak roles to Grafana roles)
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(roles[*], 'admin') && 'Admin' || contains(roles[*], 'editor') && 'Editor' || 'Viewer'
# Enable refresh token support
GF_AUTH_GENERIC_OAUTH_USE_REFRESH_TOKEN=true
# Enable group synchronization (requires group mapper in Keycloak)
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH=groups
# Allow assigning Grafana admin role
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
# Single logout URL
GF_AUTH_GENERIC_OAUTH_SIGNOUT_REDIRECT_URL=xxxxx
# Disable auto login to show the login screen with OAuth button
GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN=true

# --- Grafana Server Configuration ---
# Root URL for Grafana (needed for OAuth callbacks)
GF_SERVER_ROOT_URL=http://localhost:3001
# Domain for Grafana
GF_SERVER_DOMAIN=localhost

# --- Matomo ---
# Matomo DB host (should match matomo-db service)
MATOMO_DATABASE_HOST=matomo-db
# Matomo DB adapter
MATOMO_DATABASE_ADAPTER=mysqli
# Matomo DB tables prefix
MATOMO_DATABASE_TABLES_PREFIX=matomo_
# Matomo DB username
MATOMO_DATABASE_USERNAME=matomo
# Matomo DB password
MATOMO_DATABASE_PASSWORD=matomopw
# Matomo DB name
MATOMO_DATABASE_DBNAME=matomo

# --- Matomo Analytics Integration ---
MATOMO_SITE_ID=1
MATOMO_SERVER_ADDRESS=http://localhost:8081
MATOMO_TOKEN_AUTH=XXXX

# --- Decidim Analytics Configuration ---
# Enable HTML header snippets for Matomo integration
DECIDIM_ENABLE_HTML_HEADER_SNIPPETS=true
# Decidim host and port for CORS and CSP configuration
DECIDIM_HOST=decidim
DECIDIM_PORT=3000

# --- Shakapacker (Webpack dev server) ---
SHAKAPACKER_DEV_SERVER_HOST=0.0.0.0

# --- Jitsi Base Configuration ---
JITSI_HTTP_PORT=8000
JITSI_HTTPS_PORT=8443
JITSI_UDP_PORT=10000
DOCKER_HOST_ADDRESS=127.0.0.1
PUBLIC_URL=https://localhost:8000
XMPP_DOMAIN=meet.jitsi
XMPP_SERVER=jitsi-prosody
XMPP_BOSH_URL_BASE=http://jitsi-prosody:5280
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_MODULES=
JVB_BREWERY_MUC=jvbbrewery
JVB_AUTH_USER=jvb
JVB_PORT=10000
JVB_STUN_SERVERS=stun.l.google.com:19302,stun1.l.google.com:19302
JVB_ENABLE_APIS=rest,colibri
JICOFO_AUTH_USER=focus

# --- Password (use secure passwords in production) ---
JICOFO_AUTH_PASSWORD=focuspassword
JVB_AUTH_PASSWORD=jvbpassword

# Disable authentication for local development
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=jwt

# --- JWT Configuration for Jitsi ---
# Jitsi App ID for JWT authentication
JITSI_APP_ID=decidim_app
# JWT Secret Key (RSA private key or HMAC secret)
# For development, using a simple secret. In production, use a proper RSA key
JITSI_SECRET=xxxxx
# JWT Algorithm (RS256 for RSA, HS256 for HMAC)
JITSI_JWT_ALGORITHM=HS256


# --- Decidim Meetings Configuration ---
# Embeddable services for meetings (space-separated list)
MEETINGS_EMBEDDABLE_SERVICES=www.youtube.com www.twitch.tv meet.jit.si our-jitsi-link.ldt localhost

# --- Backend Service Configuration ---
# Backend API port
PORT=3002
# API context URL
CONTEXT_URL=/api/v1

# CORS Configuration
CORS_ORIGINS=http://localhost:5001,http://localhost:3000,http://localhost:3001

# Swagger Documentation
SWAGGER_GEN_DOC_FILE=true

# Security Configuration
DISABLE_HELMET=false

# JWT Configuration (reuses Keycloak secret)
JWT_ISSUER_PUBKEY=""
JWT_ENABLE_CHECK=false
JWT_TOKEN_URL=

# Backend Database Configuration (reuses existing database variables)
DATABASE_SYNC=false
DB_DIALECT=postgres
DB_MAX_POOL=100
DB_MIN_POOL=2
DB_IDLE_POOL=10000
DB_ACQUIRE_POOL=60000
DB_EVICT_POOL=1000
DB_SCHEMA=public
SEQUELIZE_SEEDER_STORAGE=sequelize
SEQUELIZE_SEEDER_STORAGE_TABLE_NAME=SequelizeData
SEQUELIZE_MIGRATION_STORAGE=sequelize
SEQUELIZE_MIGRATION_STORAGE_TABLE_NAME=SequelizeData

# Logger Configuration
LOGGER_TARGET=
LOGGER_LEVEL=info

# Cypher Configuration (reuses Keycloak secret as base)
CYPHER_SECRET=${OMNIAUTH_KEYCLOAK_CLIENT_SECRET}_backend
CYPHER_SALT=randomsalt

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute

# Performance Monitoring
EVENT_LOOP_DELAY=900000
MAX_HEAP_USED_BYTES=90000000000
MAX_RSS_BYTES=90000000000
MAX_EVENT_LOOP_USE=0.98

# Additional settings
TZ=Europe/Rome
CONFIG=./jitsi-meet-cfg
RESTART_POLICY=unless-stopped

TOOL2_EXPERIMENTS_URL=https://xxx
TOOL2_IFRAME_URL=https://xxx

TOOL1_MAPS_URL=https://xxx


# TOOL0 Domain
TOOL0_DOMAIN=https://xxx
# TOOL0 API endpoint for applications
TOOL0_API_TOOLBAR_APPLICATIONS=/api/dashboard/applications/external-tools
# TOOL0 Full URL for API calls (deprecated, will build from DOMAIN + API_PATH)
TOOL0_FULL_URL=https://xxx
HELP_URL=https://xxx