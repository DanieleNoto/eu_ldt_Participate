					"editorMode": "code",
					"format": "time_series",
					"rawQuery": true,
					"rawSql": "SELECT \n  DATE_TRUNC('day', created_at) as time,\n  COUNT(*) as \"Comments\"\nFROM decidim_comments_comments \nWHERE created_at >= NOW() - INTERVAL '30 days' AND deleted_at IS NULL\nGROUP BY DATE_TRUNC('day', created_at)\nUNION ALL\nSELECT \n  DATE_TRUNC('day', created_at) as time,\n  COUNT(*) as \"Proposals\"\nFROM decidim_proposals_proposals \nWHERE created_at >= NOW() - INTERVAL '30 days' AND deleted_at IS NULL\nGROUP BY DATE_TRUNC('day', created_at)\nORDER BY time;",
					"refId": "A"
				}
			],
			"title": "Daily Activity Trend (30 days)",
			"type": "timeseries"
