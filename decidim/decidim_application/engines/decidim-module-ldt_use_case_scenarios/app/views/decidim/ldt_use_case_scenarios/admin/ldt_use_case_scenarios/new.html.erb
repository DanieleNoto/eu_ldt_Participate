<% add_decidim_page_title(t(".title")) %>
<%
  experiments_api_url = ENV.fetch("TOOL2_EXPERIMENTS_URL", "https://ucs-int.ldttoolbox.app/api/v1/experiment-executions")
  experiment_detail_base_url = ENV.fetch("TOOL2_UI_BASE_URL", "https://ucs-int.ldttoolbox.app")
%>

<div class="item_show__header">
  <h1 class="item_show__header-title">
    <%= t(".title") %>
  </h1>
</div>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <div class="card experiments-association"
         data-admin-path="<%= "/admin/participatory_processes/#{current_participatory_space.slug}/components/#{current_component.id}/manage/ldt_use_case_scenarios" %>"
         data-experiment-detail-base-url="<%= experiment_detail_base_url %>"
         data-total-pages="<%= @total_pages || 1 %>"
         data-page-size="<%= @page_size || 10 %>"
         data-i18n-name-required="<%= t(".name_required") %>"
         data-i18n-save-error="<%= t(".save_error") %>"
         data-i18n-details-title="<%= t(".experiment_details.title") %>"
         data-i18n-details-experiment-name="<%= t(".experiment_details.experiment_name") %>"
         data-i18n-details-experimentId="<%= t(".experiment_details.experimentId") %>"
         data-i18n-details-scenarioId="<%= t(".experiment_details.scenarioId") %>"
         data-i18n-details-status="<%= t(".experiment_details.status") %>"
         data-i18n-details-loading="<%= t(".experiment_details.loading") %>"
         data-i18n-details-error="<%= t(".experiment_details.error") %>"
         data-i18n-details-na="<%= t(".experiment_details.not_available") %>">

      <% if @experiments_error.present? %>
        <div id="error-state">
          <div class="callout alert">
            <p id="error-message"><%= @experiments_error %></p>
          </div>
        </div>
      <% elsif @experiments.nil? || @experiments.empty? %>
        <div id="empty-state">
          <p><%= t(".no_experiments") %></p>
        </div>
      <% else %>
        <div id="experiments-container" style="display: block;">
          <!-- Filters: execution id and experiment id – auto-apply on change -->
          <div class="experiments-filters" style="margin-bottom: 1rem; display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
            <label for="filter-execution-id" style="font-weight: 600;"><%= t(".filter_execution_id_label", default: "Execution ID") %>:</label>
            <input id="filter-execution-id" type="text"
                   placeholder="<%= t('.filter_execution_id_placeholder', default: 'Full UUID…') %>"
                   style="padding: 0.25rem;" />

            <label for="filter-experiment-id" style="font-weight: 600;"><%= t(".filter_experiment_id_label", default: "Experiment ID") %>:</label>
            <input id="filter-experiment-id" type="text"
                   placeholder="<%= t('.filter_experiment_id_placeholder', default: 'Full UUID…') %>"
                   style="padding: 0.25rem;" />

            <button id="filter-clear" class="button button__sm" type="button" style="margin-left: auto;" disabled>
              <%= t('.clear', default: 'Clear') %>
            </button>
          </div>

          <div class="table-stacked">
            <table class="table-list w-full" style="width: 100%;">
              <thead id="experiments-thead">
                <tr>
                  <th><%= t(".select") %></th>
                  <th class="!text-left"><%= t(".experiment_name") %></th>
                  <th class="!text-left"><%= t(".experiment_and_scenario_ids") %></th>
                  <th><%= t(".status") %></th>
                  <th><%= t(".created") %></th>
                  <th><%= t(".version") %></th>
                </tr>
              </thead>
              <tbody id="experiments-tbody">
                <% @experiments.each do |exp| %>
                  <tr data-experiment-id="<%= exp['id'] %>">
                    <td data-label="Select">
                      <input type="radio" name="selected_experiment" value="<%= exp['id'] %>" class="select-experiment-radio">
                    </td>
                    <td class="!text-left" data-label="Experiment Name">
                      <% execution_id = exp['id'].to_s %>
                      <% experiment_id = exp['experimentId'].to_s %>
                      <% scenario_id = exp['scenarioId'].to_s %>
                      <% has_all_ids = execution_id.present? && experiment_id.present? && scenario_id.present? %>
                      <% experiment_external_url = "#{experiment_detail_base_url}/simulation/scenarios/#{ERB::Util.url_encode(scenario_id)}/create/experiment/#{ERB::Util.url_encode(experiment_id)}/execute/#{ERB::Util.url_encode(execution_id)}" %>
                      <% if has_all_ids %>
                        <strong class="experiment-name">
                          <%= link_to(exp.dig('experiment', 'name') || t(".no_name"), experiment_external_url, target: "_blank", rel: "noopener noreferrer") %>
                        </strong>
                      <% else %>
                        <strong class="experiment-name"><%= exp.dig('experiment', 'name') || t(".no_name") %></strong>
                      <% end %>
                    </td>
                    <td class="!text-left" data-label="Experiment ID / Scenario ID">
                      <div><strong><%= exp['experimentId'] %></strong></div>
                      <div class="text-sm text-gray-600"><%= exp['scenarioId'] %></div>
                    </td>
                    <td data-label="Status" class="experiment-status">
                      <%= exp['status'] %>
                    </td>
                    <td data-label="Created">
                      <% if exp['createdAt'] || exp['created_at'] %>
                        <%= Time.parse(exp['createdAt'] || exp['created_at']).strftime('%Y-%m-%d %H:%M') rescue exp['createdAt'] || exp['created_at'] %>
                      <% end %>
                    </td>
                    <td data-label="Version">
                      <%= exp['experimentVersion'] %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <div class="table-controls">
            <div data-pagination></div>
          </div>
        </div>

      <% end %>

      <!-- Form Section - Always visible -->
      <%= decidim_form_for(@form, url: ldt_use_case_scenarios_path, html: { class: "form-defaults form use_case_scenario_form new_use_case_scenario" }) do |f| %>
        <div class="form__wrapper">
          <div id="form-section" class="card-section">
            <!-- Hidden field for experiment_id -->
            <%= f.hidden_field :experiment_id, id: "experiment-id-field" %>
            <%= f.hidden_field :component_id, value: current_component.id %>

            <!-- Selected experiment info will be inserted here by JavaScript -->
            <div data-selected-experiment-info></div>

            <!-- Association Name Field -->
            <div class="field">
              <%= f.text_field :name,
                  id: "association-name",
                  placeholder: t('.enter_association_name'),
                  required: true %>

            </div>
          </div>
        </div>

        <!-- Sticky Footer - Always visible -->
        <div class="item__edit-sticky">
          <div class="item__edit-sticky-container">
            <%= f.submit t(".save"), id: "save-button", class: "button button__sm button__secondary" %>
          </div>
        </div>
      <% end %>
</div>

<!-- Hidden i18n for JS -->
<span data-i18n="name_required" style="display: none;"><%= t(".name_required") %></span>
<span data-i18n="save_error" style="display: none;"><%= t(".save_error") %></span>

<%= append_stylesheet_pack_tag "experiments_association" %>
<%= append_javascript_pack_tag "experiments_association" %>
