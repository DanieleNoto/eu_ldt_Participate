#
# Fill the values and save as .env (without .example suffix) for Helm deployment.
# This file drives: 03-apply-manifests.sh → generate-values-local.py → values-local.yaml → helm upgrade --install
#
# Legend:
#   [REQUIRED]    – must be set before deploying; no safe default exists
#   [k8s default] – pre-filled with a Kubernetes-internal service default
#   [prefilled]   – value copied from .env.dev.example (docker-compose reference)
#
# For detailed descriptions of each variable, see:
#   infrastructure/scripts/ENVIRONMENT_VARIABLES_DESCRIPTIONS.md

# ============================================================================
# DECIDIM APPLICATION
# ============================================================================
#   [prefilled from .env.dev.example]
CHATBOT-BACKEND-URL=http://localhost:3002
CHATBOT-URL=http://localhost:5001
DECIDIM-AVAILABLE-LOCALES=en,it,es
DECIDIM-DEFAULT-LOCALE=en
DECIDIM-HOST=localhost
DECIDIM-JITSI-URL=https://meet.jitsi
DECIDIM-THROTTLING-MAX-REQUESTS=60
GF-SERVER-DOMAIN=localhost
GF-SERVER-ROOT-URL=http://localhost:3001
MATOMO-SERVER-ADDRESS=http://localhost:8081
MATOMO-SITE-ID=1
MEETINGS-EMBEDDABLE-SERVICES=www.youtube.com www.twitch.tv meet.jit.si our-jitsi-link.ldt localhost
POSTGRES-DATABASE=decidim_production
RAILS-LOG-LEVEL=info
SMTP-AUTHENTICATION=plain
SMTP-DOMAIN=example.com
SMTP-ENABLE-STARTTLS-AUTO=true
SMTP-OPEN-TIMEOUT=10
SMTP-PORT=587
SMTP-READ-TIMEOUT=10
SMTP-TLS=false
TOOL0-API-TOOLBAR-APPLICATIONS=/api/dashboard/applications/external-tools

#   [k8s default]
DATABASE-HOST-DECIDIM=db
ENABLE-JSON-LOGS=true
KEYCLOAK-DISABLE-SSL-VERIFY=false
QUEUE-ADAPTER=sidekiq
REDIS-URL=redis://redis:6379/0
RESTART-POLICY=always

#   [REQUIRED]
#     Docker image tag to deploy (e.g. git tag v1.0.0)
CONTAINER_IMAGE_TOOL_TAG=99998
#     PostgreSQL database name for Decidim
DATABASE-NAME-DECIDIM=
#     PostgreSQL password for the Decidim database
DATABASE-PASSWORD-DECIDIM=
#     Full Postgres DSN for Decidim (postgres://user:pass@host:5432/db)
DATABASE-URL-DECIDIM=
#     PostgreSQL user for the Decidim database
DATABASE-USERNAME-DECIDIM=
#     From address for Decidim notification emails (e.g. noreply@example.com)
DECIDIM-MAILER-SENDER=
#     Help documentation URL
HELP-URL=
#     Matomo API authentication token
MATOMO-TOKEN-AUTH=
#     Keycloak OAuth2 client ID for Decidim
OMNIAUTH-KEYCLOAK-CLIENT-ID=
#     Keycloak OAuth2 client secret for Decidim
OMNIAUTH-KEYCLOAK-CLIENT-SECRET=
#     Keycloak realm name
OMNIAUTH-KEYCLOAK-REALM=
#     Keycloak base URL (e.g. https://keycloak.example.com)
OMNIAUTH-KEYCLOAK-SITE=
#     Rails secret key — generate with: openssl rand -hex 64
SECRET-KEY-BASE=
#     SMTP server hostname (e.g. smtp.example.com)
SMTP-ADDRESS=
#     SMTP account password
SMTP-PASSWORD=
#     SMTP account username
SMTP-USERNAME=
#     External tool 0 domain URL
TOOL0-DOMAIN=
#     External tool 0 full URL
TOOL0-FULL-URL=
#     External tool 1 maps URL
TOOL1-MAPS-URL=
#     External tool 2 experiments URL
TOOL2-EXPERIMENTS-URL=
#     External tool 2 iframe URL
TOOL2-IFRAME-URL=

RAILS-ASSET-HOST=

# ============================================================================
# CHATBOT BACKEND
# ============================================================================
#   [prefilled from .env.dev.example]
CHATBOT-FROM-EMAIL=chatbot@example.com
CHATBOT-SUPPORT-EMAIL=support@example.com
CORS-ORIGINS=http://localhost:5001,http://localhost:3000,http://localhost:3001
DECIDIM-LOGO-URL=/images/logo.png
DECIDIM-ORGANIZATION-NAME=EU LDT Participate
DECIDIM-PRIMARY-COLOR=#0076d0

#   [k8s default]
MAX-EVENT-LOOP-USE=0.98
RATE-LIMIT-MAX=100
RATE-LIMIT-TIME-WINDOW=1 minute

#   [REQUIRED]
#     Encryption salt for chatbot backend (random string)
CYPHER-SALT=
#     Encryption secret for chatbot backend (random string)
CYPHER-SECRET=
#     Full Postgres DSN for chatbot backend
DATABASE-URL-CHATBOT=
#     PostgreSQL database name for the chatbot backend
DB-NAME-CHATBOT=
#     PostgreSQL password for the chatbot backend database
DB-PASSWORD-CHATBOT=
#     PostgreSQL user for the chatbot backend database
DB-USERNAME-CHATBOT=
#     SMTP account username (alias used by some services)
SMTP-USER-NAME=

NOTIFICATION-PREFERENCES-URL=
PRIVACY-POLICY-URL=

# ============================================================================
# CHATBOT FRONTEND
# ============================================================================
#   [prefilled from .env.dev.example]
VITE-API-URL=http://localhost:3002/api/v1

# ============================================================================
# GRAFANA
# ============================================================================
#   [prefilled from .env.dev.example]
GF-AUTH-GENERIC-OAUTH-ALLOW-ASSIGN-GRAFANA-ADMIN=true
GF-AUTH-GENERIC-OAUTH-ALLOW-SIGN-UP=true
GF-AUTH-GENERIC-OAUTH-EMAIL-ATTRIBUTE-PATH=email
GF-AUTH-GENERIC-OAUTH-GROUPS-ATTRIBUTE-PATH=groups
GF-AUTH-GENERIC-OAUTH-LOGIN-ATTRIBUTE-PATH=username
GF-AUTH-GENERIC-OAUTH-NAME=Keycloak-OAuth
GF-AUTH-GENERIC-OAUTH-NAME-ATTRIBUTE-PATH=full_name
GF-AUTH-GENERIC-OAUTH-ROLE-ATTRIBUTE-PATH=contains(roles[*], 'admin') && 'Admin' || contains(roles[*], 'editor') && 'Editor' || 'Viewer'
GF-AUTH-GENERIC-OAUTH-SCOPES=openid email profile offline_access roles
GF-DATABASE-NAME=grafana
GF-DATABASE-USER=grafana
GF-SECURITY-ADMIN-USER=admin
GF-SERVER-SERVE-FROM-SUB-PATH=false

#   [k8s default]
GF-DATABASE-HOST=grafana-db
GF-DATABASE-TYPE=postgres
GRAFANA-PGDATA-PATH=/var/lib/postgresql/data/pgdata

#   [REQUIRED]
#     Keycloak userinfo endpoint URL
GF-AUTH-GENERIC-OAUTH-API-URL=
#     Keycloak authorization endpoint URL
GF-AUTH-GENERIC-OAUTH-AUTH-URL=
#     Keycloak OAuth2 client ID for Grafana
GF-AUTH-GENERIC-OAUTH-CLIENT-ID=
#     Keycloak OAuth2 client secret for Grafana
GF-AUTH-GENERIC-OAUTH-CLIENT-SECRET=
#     Keycloak post-logout redirect URL
GF-AUTH-GENERIC-OAUTH-SIGNOUT-REDIRECT-URL=
#     Keycloak token endpoint URL
GF-AUTH-GENERIC-OAUTH-TOKEN-URL=
#     PostgreSQL password for the Grafana database
GF-DATABASE-PASSWORD=
#     Grafana admin account password
GF-SECURITY-ADMIN-PASSWORD=

# ============================================================================
# MATOMO
# ============================================================================
#   [prefilled from .env.dev.example]
MATOMO-DATABASE-DBNAME=matomo
MATOMO-DATABASE-USERNAME=matomo
MATOMO-ROOT-URL=http://matomo
MATOMO-TRUSTED-HOST=localhost
MYSQL-DATABASE=matomo
MYSQL-USER=matomo

#   [k8s default]
MATOMO-DATABASE-HOST=matomo-db-svc

#   [REQUIRED]
#     MariaDB password for Matomo
MATOMO-DATABASE-PASSWORD=
#     MariaDB password for the Matomo DB user
MYSQL-PASSWORD=
#     MariaDB root password for Matomo DB
MYSQL-ROOT-PASSWORD=

# ============================================================================
# JITSI
# ============================================================================
#   [prefilled from .env.dev.example]
JVB-STUN-SERVERS=stun.l.google.com:19302,stun1.l.google.com:19302
JWT-ACCEPTED-AUDIENCES=decidim
JWT-ACCEPTED-ISSUERS=decidim
JWT-APP-ID=decidim_app

#   [REQUIRED]
#     Jitsi Focus Component auth password
JICOFO-AUTH-PASSWORD=
#     Jitsi Video Bridge auth password
JVB-AUTH-PASSWORD=
#     JWT secret shared between Decidim and Jitsi
JWT-APP-SECRET=
#     Full public URL for Jitsi (e.g. https://jitsi.example.com)
PUBLIC-URL=

# ============================================================================
# INGRESS / PROXY
# ============================================================================
#   [REQUIRED]
#     Public hostname for Jitsi (e.g. jitsi.example.com)
JITSI-HOST=
#     Public hostname for the Participate platform (e.g. participate.example.com)
PARTICIPATE-HOST=
