					"editorMode": "code",
					"format": "table",
					"rawQuery": true,
					"rawSql": "SELECT \n  m.id,\n  COALESCE(m.title->>'en', m.title->>'it', m.title->>'fr', m.title->>'de', m.title->>'es', m.title::text) as title,\n  m.start_time,\n  m.attendees_count,\n  m.attending_organizations,\n  CASE \n    WHEN m.start_time > NOW() THEN 'Upcoming'\n    WHEN m.end_time < NOW() THEN 'Completed'\n    ELSE 'Ongoing'\n  END as status\nFROM decidim_meetings_meetings m\nWHERE m.deleted_at IS NULL AND m.start_time >= NOW() - INTERVAL '60 days'\nORDER BY m.start_time DESC\nLIMIT 10;",
					"refId": "A"
				}
			],
