<%= link_to map_visualization_path(map_visualization), class: "card__list", id: "map_visualization_#{map_visualization.id}" do %>
  <div class="card__list-content">
  <div style="display: flex; gap: 1.5rem; align-items: flex-start; flex-direction: column;">
    <% if map_visualization.map_image.present? %>
      <div class="card__list-thumbnail" style="width: 100%;">
        <%= image_tag map_visualization.map_image,
                      alt: map_visualization.name,
                      style: "width: 100%; height: 200px; object-fit: cover; border-radius: 4px;" %>
      </div>
    <% end %>

    <div class="card__list-text-content" style="width: 100%; display:flex; flex-direction: column">
      <div class="h4 card__list-title">
        <%= map_visualization.name %>
      </div>

      <% if map_visualization.map_description.present? %>
        <div class="card__list-text">
          <div class="rich-text-display">
            <%= truncate(map_visualization.map_description, length: 200, separator: ' ') %>
          </div>
        </div>
      <% end %>

      <div class="card__list-metadata">
        <% if map_visualization.map_id.present? %>
          <div>
            <svg width="1em" height="1em" role="img" aria-hidden="true">
              <use href="/decidim-packs/media/images/remixicon.symbol-e643e553623ffcd49f94.svg#ri-map-pin-line"></use>
            </svg>
            <%= truncate(map_visualization.map_id, length: 35) %>
          </div>
        <% end %>

        <% if map_visualization.map_owner.present? %>
          <div>
            <svg width="1em" height="1em" role="img" aria-hidden="true">
              <use href="/decidim-packs/media/images/remixicon.symbol-e643e553623ffcd49f94.svg#ri-user-line"></use>
            </svg>
            <%= truncate(map_visualization.map_owner, length: 30) %>
          </div>
        <% end %>

        <div>
          <svg width="1em" height="1em" role="img" aria-hidden="true">
            <use href="/decidim-packs/media/images/remixicon.symbol-e643e553623ffcd49f94.svg#ri-calendar-todo-line"></use>
          </svg>
          <%= l map_visualization.created_at, format: :decidim_short %>
        </div>
      </div>
    </div>
    </div>
  </div>
<% end %>
