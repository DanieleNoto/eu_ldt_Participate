<% add_decidim_page_title(t(".title")) %>

<div class="card experiments-association" data-admin-path="<%= "/admin/participatory_processes/#{current_participatory_space.slug}/components/#{current_component.id}/manage/ldt_use_case_scenarios" %>" data-i18n-name-required="<%= t(".name_required") %>" data-i18n-save-error="<%= t(".save_error") %>">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t(".title") %>
    </h1>
  </div>

  <div id="experiments-container" style="display: none;">
    <div class="table-stacked">
      <table class="table-list">
        <thead id="experiments-thead">
          <tr>
            <th><%= t(".experiment_id") %></th>
            <th class="!text-left"><%= t(".experiment_name") %></th>
            <th><%= t(".description") %></th>
            <th><%= t(".actions") %></th>
          </tr>
        </thead>
        <tbody id="experiments-tbody">
        </tbody>
      </table>
    </div>

    <div class="table-controls">
      <button type="button" id="prev-page-button" class="button button__secondary"><%= t(".previous_page") %></button>
      <span id="page-info"></span>
      <button type="button" id="next-page-button" class="button button__secondary"><%= t(".next_page") %></button>
      <button type="button" id="save-button" class="button button__secondary" disabled><%= t(".save") %></button>
    </div>
  </div>

  <div id="loading-state">
    <p><%= t(".loading_experiments") %></p>
  </div>

  <div id="error-state" style="display: none;">
    <div class="callout alert">
      <p id="error-message"></p>
    </div>
  </div>
</div>

<!-- Modal -->
<div id="confirmation-modal" style="display: none;">
  <div class="reveal" style="display: block;">
    <div class="reveal__header">
      <h2 class="reveal__title"><%= t(".confirm_title") %></h2>
    </div>

    <div class="reveal__content">
      <p><%= t(".confirm_message") %></p>
      
      <div style="margin-top: 20px;">
        <label><strong><%= t(".association_name") %></strong></label>
        <input type="text" id="association-name" placeholder="<%= t('.enter_association_name') %>" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; margin-top: 8px;">
      </div>
    </div>

    <div class="reveal__footer">
      <button type="button" id="modal-cancel" class="button button__secondary"><%= t(".cancel") %></button>
      <button type="button" id="modal-confirm" class="button button__primary"><%= t(".confirm") %></button>
    </div>
  </div>
</div>

<!-- Hidden i18n for JS -->
<span data-i18n="name_required" style="display: none;"><%= t(".name_required") %></span>
<span data-i18n="save_error" style="display: none;"><%= t(".save_error") %></span>

<%= append_stylesheet_pack_tag "experiments_association" %>
<%= append_javascript_pack_tag "experiments_association" %>
