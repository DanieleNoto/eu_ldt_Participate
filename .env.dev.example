# ============================================================================
# ENVIRONMENT & RAILS CONFIGURATION
# ============================================================================
# Rails environment (development, production, test)
RAILS_ENV=development
# Node.js environment
NODE_ENV=development
# Rails logging level
RAILS_LOG_LEVEL=info
# Log to STDOUT (true/false)
RAILS_LOG_TO_STDOUT=true
# Rails asset host
RAILS_ASSET_HOST=
# Timezone
TZ=Europe/Rome
# Enable JSON logs
ENABLE_JSON_LOGS=false

# ============================================================================
# DATABASE - Decidim PostgreSQL (decidim/db)
# ============================================================================
# Hostname or IP of the Postgres DB container
DATABASE_HOST=db
# Username for Postgres DB
DATABASE_USERNAME=postgres
# Password for Postgres DB
DATABASE_PASSWORD=postgres
# Database name for Decidim
DATABASE_NAME=decidim_application_development
# Decidim Database port
DB_PORT=5432
# Full database connection string used by the backend service
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:postgres@db:5432/decidim_application_development
# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=decidim_production
POSTGRES_DATABASE=decidim_production
PGDATA=/var/lib/postgresql/data/pgdata

# ============================================================================
# REDIS (decidim/redis)
# ============================================================================
# Redis connection URL
REDIS_URL=redis://redis:6379/0

# ============================================================================
# DECIDIM APPLICATION (decidim)
# ============================================================================
# Rails secret key base (change in production!)
SECRET_KEY_BASE=insecure_key_base
# Force HTTPS (set to true in production)
DECIDIM_FORCE_SSL=false
# Protocol for Decidim (http or https)
DECIDIM_PROTOCOL=https
# Decidim host name/domain
DECIDIM_HOST=localhost
# Decidim custom URL
DECIDIM_URL=http://localhost:3000
# Decidim organization name
DECIDIM_ORGANIZATION_NAME=EU LDT Participate
# Decidim available locales
DECIDIM_AVAILABLE_LOCALES=en,it,es
# Decidim default locale
DECIDIM_DEFAULT_LOCALE=en
# Decidim primary color (hex)
DECIDIM_PRIMARY_COLOR=#0076d0
# Enable HTML header snippets for integrations (Matomo, etc)
DECIDIM_ENABLE_HTML_HEADER_SNIPPETS=true
# Decidim logo URL
DECIDIM_LOGO_URL=/images/logo.png
# Enable service worker
DECIDIM_SERVICE_WORKER_ENABLED=false
# Throttling max requests per minute
DECIDIM_THROTTLING_MAX_REQUESTS=60
# Follow X-Forwarded-Host header
DECIDIM_FOLLOW_HTTP_X_FORWARDED_HOST=true
# Email sender for Decidim notifications
DECIDIM_MAILER_SENDER=changeme@example.org
# ActiveJob queue adapter (async for dev, sidekiq for prod)
QUEUE_ADAPTER=async
# Shakapacker (Webpack dev server)
SHAKAPACKER_DEV_SERVER_HOST=0.0.0.0

# ============================================================================
# EMAIL & SMTP CONFIGURATION
# ============================================================================
# SMTP server address (e.g. smtp.gmail.com)
SMTP_ADDRESS=smtp.example.com
# SMTP server port (e.g. 587)
SMTP_PORT=587
# SMTP username
SMTP_USERNAME=your_smtp_username
SMTP_USER_NAME=your_smtp_username
# SMTP password
SMTP_PASSWORD=your_smtp_password
# SMTP domain (e.g. example.com)
SMTP_DOMAIN=example.com
# SMTP authentication type (plain, login, cram_md5)
SMTP_AUTHENTICATION=plain
# Enable STARTTLS (true/false)
SMTP_ENABLE_STARTTLS_AUTO=true
# Enable TLS for SMTP
SMTP_TLS=false
# SMTP connection open timeout (seconds)
SMTP_OPEN_TIMEOUT=10
# SMTP read timeout (seconds)
SMTP_READ_TIMEOUT=10
# OpenSSL verify mode (optional, e.g. none)
SMTP_OPENSSL_VERIFY_MODE=

# ============================================================================
# KEYCLOAK AUTHENTICATION (oauth)
# ============================================================================
# Keycloak OAuth Client ID
OMNIAUTH_KEYCLOAK_CLIENT_ID=xxxx
# Keycloak OAuth Client Secret
OMNIAUTH_KEYCLOAK_CLIENT_SECRET=xxxx
# Keycloak Site URL
OMNIAUTH_KEYCLOAK_SITE=xxx
# Keycloak Realm
OMNIAUTH_KEYCLOAK_REALM=xxx
# Disable SSL verification for Keycloak (development only!)
KEYCLOAK_DISABLE_SSL_VERIFY=false

# ============================================================================
# CHATBOT (frontend & backend)
# ============================================================================
# Enable/disable chatbot widget injection
CHATBOT_ENABLED=true
# Chatbot Frontend URL (accessible from user's browser)
# Development (accessing from host): http://localhost:5001
# Development (using Docker network): Use actual domain or localhost
# Production: https://chatbot.your-domain.com
CHATBOT_URL=http://localhost:5001
# Chatbot backend API URL (for CSP connect-src directive)
# Development: http://localhost:3002
# Docker: http://backend:3002
# Production: https://api.your-domain.com
CHATBOT_BACKEND_URL=http://localhost:3002
# Optional cache-busting token for static assets (recommended for production)
# In production, set this to your git commit SHA or build timestamp
CHATBOT_ASSET_VERSION=1.0.0
# Chatbot support email
CHATBOT_SUPPORT_EMAIL=support@example.com
# Chatbot sender email
CHATBOT_FROM_EMAIL=chatbot@example.com

# ============================================================================
# JITSI VIDEO CONFERENCING (jitsi)
# ============================================================================
# Jitsi HTTP port
JITSI_HTTP_PORT=8000
# Jitsi HTTPS port
JITSI_HTTPS_PORT=8443
# Jitsi UDP port
JITSI_UDP_PORT=10000
# Jitsi Web URL
JITSI_WEB_URL=https://localhost:8443
# Docker host address
DOCKER_HOST_ADDRESS=127.0.0.1
# Public URL
PUBLIC_URL=https://localhost:8000
# Decidim Jitsi URL
DECIDIM_JITSI_URL=https://meet.jitsi
# Jitsi meeting room prefix
DECIDIM_JITSI_ROOM_PREFIX=decidim-meeting-
# XMPP Domain
XMPP_DOMAIN=meet.jitsi
# XMPP Server
XMPP_SERVER=jitsi-prosody
# XMPP BOSH URL Base
XMPP_BOSH_URL_BASE=http://jitsi-prosody:5280
# XMPP Auth Domain
XMPP_AUTH_DOMAIN=auth.meet.jitsi
# XMPP MUC Domain
XMPP_MUC_DOMAIN=muc.meet.jitsi
# XMPP Internal MUC Domain
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
# XMPP Guest Domain
XMPP_GUEST_DOMAIN=guest.meet.jitsi
# XMPP Recorder Domain
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
# XMPP Modules
XMPP_MODULES=
# Enable XMPP WebSocket
ENABLE_XMPP_WEBSOCKET=true
# JVB Brewery MUC
JVB_BREWERY_MUC=jvbbrewery
# JVB Auth User
JVB_AUTH_USER=jvb
# JVB Auth Password
JVB_AUTH_PASSWORD=jvbpassword
# JVB Port
JVB_PORT=10000
# JVB STUN Servers
JVB_STUN_SERVERS=stun.l.google.com:19302,stun1.l.google.com:19302
# JVB Enable APIs
JVB_ENABLE_APIS=rest,colibri
# Jicofo Auth User
JICOFO_AUTH_USER=focus
# Jicofo Auth Password
JICOFO_AUTH_PASSWORD=focuspassword
# Enable/disable authentication for local development
ENABLE_AUTH=1
# Enable guests
ENABLE_GUESTS=1
# Authentication type
AUTH_TYPE=jwt
# Grant Moderator privilege (for Jitsi)
DISABLE_GRANT_MODERATOR=false
# Enable local recording
DISABLE_LOCAL_RECORDING=false
# Notify all participants about local recording
ENABLE_LOCAL_RECORDING_NOTIFY_ALL_PARTICIPANT=true
# Enable subdomains
ENABLE_SUBDOMAINS=true
# Show welcome page
ENABLE_WELCOME_PAGE=false
# Toolbar buttons configuration
TOOLBAR_BUTTONS=microphone,camera,closedcaption,desktop,fullscreen,fodeviceselection,hangup,profile,chat,sharedvideo,settings,raisehand,videoquality,filmstrip,invite,feedback,stats,shortcuts,recording,livestreaming,etherpad,whiteboard,download,help,mute-everyone,security
# Subdirectory for reverse proxy
SUBDIR=
# Configuration file
CONFIG=./jitsi-meet-cfg
# Restart policy
RESTART_POLICY=unless-stopped

# ============================================================================
# JITSI JWT AUTHENTICATION
# ============================================================================
# Jitsi App ID for JWT authentication
JWT_APP_ID=decidim_app
# JWT App Secret
JWT_APP_SECRET=xxxxx
# Accepted issuers for JWT tokens
JWT_ACCEPTED_ISSUERS=decidim
# Accepted audiences for JWT tokens
JWT_ACCEPTED_AUDIENCES=decidim

# ============================================================================
# DECIDIM MEETINGS
# ============================================================================
# Embeddable services for meetings (space-separated list)
MEETINGS_EMBEDDABLE_SERVICES=www.youtube.com www.twitch.tv meet.jit.si our-jitsi-link.ldt localhost
# Notification preferences URL
NOTIFICATION_PREFERENCES_URL=
# Privacy policy URL
PRIVACY_POLICY_URL=

# ============================================================================
# BACKEND SERVICE (backend)
# ============================================================================
# Backend API port
PORT=3002
# API context URL
CONTEXT_URL=/api/v1
# Backend database type
DB_DIALECT=postgres
# Backend database host
DB_HOST=db
# Backend database port
DB_PORT=5432
# Backend database username
DB_USERNAME=postgres
# Backend database password
DB_PASSWORD=postgres
# Backend database name
DB_NAME=backend_db
# Database sync
DATABASE_SYNC=false
# Database pool configuration
DB_MAX_POOL=100
DB_MIN_POOL=2
DB_IDLE_POOL=10000
DB_ACQUIRE_POOL=60000
DB_EVICT_POOL=1000
DB_SCHEMA=public
# Sequelize configuration
SEQUELIZE_SEEDER_STORAGE=sequelize
SEQUELIZE_SEEDER_STORAGE_TABLE_NAME=SequelizeData
SEQUELIZE_MIGRATION_STORAGE=sequelize
SEQUELIZE_MIGRATION_STORAGE_TABLE_NAME=SequelizeData
# Logger configuration
LOGGER_TARGET=
LOGGER_LEVEL=info
# CORS Configuration
CORS_ORIGINS=http://localhost:5001,http://localhost:3000,http://localhost:3001
# Security Configuration
DISABLE_HELMET=false
# Swagger Documentation
SWAGGER_GEN_DOC_FILE=true
# JWT Configuration
JWT_ISSUER_PUBKEY=""
JWT_ENABLE_CHECK=false
JWT_TOKEN_URL=
# Cypher Configuration (reuses Keycloak secret as base)
CYPHER_SECRET=${OMNIAUTH_KEYCLOAK_CLIENT_SECRET}_backend
CYPHER_SALT=randomsalt
# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=1 minute
# Performance Monitoring
EVENT_LOOP_DELAY=900000
MAX_HEAP_USED_BYTES=90000000000
MAX_RSS_BYTES=90000000000
MAX_EVENT_LOOP_USE=0.98
# Vite/Frontend Configuration
VITE_API_URL=http://localhost:3002/api/v1

# ============================================================================
# GRAFANA ANALYTICS (analytics/grafana)
# ============================================================================
# Grafana admin user
GF_SECURITY_ADMIN_USER=admin
# Grafana admin password
GF_SECURITY_ADMIN_PASSWORD=admin
# Grafana Server Configuration
GF_SERVER_ROOT_URL=http://localhost:3001
GF_SERVER_DOMAIN=localhost
# Serve from sub path
GF_SERVER_SERVE_FROM_SUB_PATH=false
# Grafana URL
GRAFANA_URL=http://grafana:3000
# Enable basic authentication
GF_AUTH_BASIC_ENABLED=false
# Disable login form
GF_AUTH_DISABLE_LOGIN_FORM=false
# Disable signout menu
GF_AUTH_DISABLE_SIGNOUT_MENU=false
# Allow embedding
GF_SECURITY_ALLOW_EMBEDDING=false
# Cookie secure flag
GF_SECURITY_COOKIE_SECURE=false
# Cookie SameSite attribute
GF_SECURITY_COOKIE_SAMESITE=Lax
# X-Frame-Options header
GF_SECURITY_X_FRAME_OPTIONS=deny
# Panels disable sanitize HTML
GF_PANELS_DISABLE_SANITIZE_HTML=false
# Paths provisioning
GF_PATHS_PROVISIONING=/etc/grafana/provisioning
# Allow organization creation
GF_USERS_ALLOW_ORG_CREATE=false
# Auto assign organization
GF_USERS_AUTO_ASSIGN_ORG=false
# Auto assign organization ID
GF_USERS_AUTO_ASSIGN_ORG_ID=1
# Auto assign organization role
GF_USERS_AUTO_ASSIGN_ORG_ROLE=Viewer
# Default theme
GF_USERS_DEFAULT_THEME=dark

# ============================================================================
# GRAFANA DATABASE (analytics/grafana/db)
# ============================================================================
# Grafana Database type
GF_DATABASE_TYPE=postgres
# Grafana Database host
GF_DATABASE_HOST=grafana-db
# Grafana Database user
GF_DATABASE_USER=grafana
# Grafana Database password
GF_DATABASE_PASSWORD=grafana
# Grafana Database name
GF_DATABASE_NAME=grafana

# ============================================================================
# GRAFANA KEYCLOAK OAUTH2 AUTHENTICATION
# ============================================================================
# Enable Keycloak OAuth2 for Grafana
GF_AUTH_GENERIC_OAUTH_ENABLED=true
# Name displayed on the login button
GF_AUTH_GENERIC_OAUTH_NAME=Keycloak-OAuth
# Allow signup through OAuth
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
# Keycloak client ID for Grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=xxxx
# Keycloak client secret for Grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=xxxx
# OAuth scopes
GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile offline_access roles
# User attribute mappings
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=username
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=full_name
# Keycloak OAuth URLs
GF_AUTH_GENERIC_OAUTH_AUTH_URL=xxxxx
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=xxxx
GF_AUTH_GENERIC_OAUTH_API_URL=xxxxx
# Role mapping (maps Keycloak roles to Grafana roles)
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(roles[*], 'admin') && 'Admin' || contains(roles[*], 'editor') && 'Editor' || 'Viewer'
# Enable refresh token support
GF_AUTH_GENERIC_OAUTH_USE_REFRESH_TOKEN=true
# Enable group synchronization (requires group mapper in Keycloak)
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH=groups
# Allow assigning Grafana admin role
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
# Single logout URL
GF_AUTH_GENERIC_OAUTH_SIGNOUT_REDIRECT_URL=xxxxx
# Disable auto login to show the login screen with OAuth button
GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN=true

# ============================================================================
# MATOMO ANALYTICS (analytics/matomo)
# ============================================================================
# Matomo Database host
MATOMO_DATABASE_HOST=matomo-db
# Matomo Database adapter
MATOMO_DATABASE_ADAPTER=mysqli
# Matomo Database tables prefix
MATOMO_DATABASE_TABLES_PREFIX=matomo_
# Matomo Database username
MATOMO_DATABASE_USERNAME=matomo
# Matomo Database password
MATOMO_DATABASE_PASSWORD=matomopw
# Matomo Database name
MATOMO_DATABASE_DBNAME=matomo
# Matomo Site ID
MATOMO_SITE_ID=1
# Matomo Server Address
MATOMO_SERVER_ADDRESS=http://localhost:8081
# Matomo URL
MATOMO_URL=http://matomo:80
# Matomo Root URL
MATOMO_ROOT_URL=http://matomo
# Matomo Token Auth
MATOMO_TOKEN_AUTH=XXXX
# Force HTTPS for Matomo
MATOMO_FORCE_SSL=false
# Assume secure protocol (true for reverse proxy with SSL)
MATOMO_ASSUME_SECURE_PROTOCOL=false
# Trusted host header
MATOMO_TRUSTED_HOST=localhost
# Proxy URI header for IP detection
MATOMO_PROXY_URI_HEADER=

# ============================================================================
# MYSQL CONFIGURATION (for Matomo)
# ============================================================================
# MySQL database name
MYSQL_DATABASE=matomo
# MySQL user
MYSQL_USER=matomo
# MySQL password
MYSQL_PASSWORD=matomopw
# MySQL root password
MYSQL_ROOT_PASSWORD=rootpassword

# ============================================================================
# PHP CONFIGURATION (for Matomo)
# ============================================================================
# PHP memory limit
PHP_MEMORY_LIMIT=256M
# PHP max execution time (seconds)
PHP_MAX_EXECUTION_TIME=300

# ============================================================================
# EXTERNAL TOOLS INTEGRATION
# ============================================================================
# Tool 0 Configuration
TOOL0_DOMAIN=https://xxx
TOOL0_API_TOOLBAR_APPLICATIONS=/api/dashboard/applications/external-tools
TOOL0_FULL_URL=https://xxx

# Tool 1 Configuration
TOOL1_MAPS_URL=https://xxx
PV_EMBED_BASE_URL=https://xxx/embed/maps_visualisation

# Tool 2 Configuration
TOOL2_EXPERIMENTS_URL=https://xxx
TOOL2_IFRAME_URL=https://xxx

# Help URL
HELP_URL=https://xxx