			},
			"targets": [
				{
					"datasource": {
						"type": "postgres",
						"uid": "decidim_postgres"
					},
					"editorMode": "code",
					"format": "table",
					"rawQuery": true,
					"rawSql": "SELECT \n  u.nickname,\n  u.name,\n  COUNT(DISTINCT c.id) as comments_count,\n  COUNT(DISTINCT p.id) as proposals_count,\n  COUNT(DISTINCT e.id) as endorsements_count,\n  (COUNT(DISTINCT c.id) + COUNT(DISTINCT p.id) + COUNT(DISTINCT e.id)) as total_activity\nFROM decidim_users u\nLEFT JOIN decidim_comments_comments c ON u.id = c.decidim_author_id AND c.decidim_author_type = 'Decidim::User' AND c.deleted_at IS NULL\nLEFT JOIN decidim_proposals_proposals p ON u.id = p.decidim_author_id AND p.decidim_author_type = 'Decidim::User' AND p.deleted_at IS NULL\nLEFT JOIN decidim_endorsements e ON u.id = e.decidim_author_id AND e.decidim_author_type = 'Decidim::User'\nWHERE u.deleted_at IS NULL AND u.type = 'Decidim::User'\nGROUP BY u.id, u.nickname, u.name\nHAVING (COUNT(DISTINCT c.id) + COUNT(DISTINCT p.id) + COUNT(DISTINCT e.id)) > 0\nORDER BY total_activity DESC\nLIMIT 10;",
					"refId": "A"
				}
			],
			"title": "Top Active Users",
			"type": "table"
		},
