<% add_decidim_meta_tags(
  description: translated_attribute(current_component.participatory_space.try(:description)),
  title: decidim_escape_translated(translated_attribute(current_component.name)),
  url: map_visualizations_url,
  resource: current_component
) %>

<% content_for :aside do %>
  <h1 class="title-decorator"><%= decidim_escape_translated(translated_attribute(current_component.name)) %></h1>
<% end %>

<%= render layout: "layouts/decidim/shared/layout_two_col" do %>
  <section id="map-visualizations" class="layout-main__section layout-main__heading">
    <%= render partial: "map_visualizations" %>
  </section>
<% end %>
