exclude:
    global:
        - tests
ignore:
    SNYK-JS-UUID-16133035:
        - '*':
            reason: uuid@14 is an ESM-only package, incompatible with how sequelize@6 loads it internally using CommonJS require(). Forcing an override would break database functionality entirely. The vulnerability is only exploitable when a caller passes an external memory buffer directly to the uuid generation function — a pattern our code never uses. We only call uuidv4() to generate plain UUID strings. There is no realistic attack vector through our application.
            expires: '2027-01-01T00:00:00.000Z'
