<%# Password field for updating user's password %>
<div class="user-password" data-controller="password-validator" data-show-password="<%= t 'show_password', scope: 'decidim.devise.shared.password_fields' %>" data-hide-password="<%= t 'hide_password', scope: 'decidim.devise.shared.password_fields' %>" data-hidden-password="<%= t 'hidden_password', scope: 'decidim.devise.shared.password_fields' %>" data-shown-password="<%= t 'shown_password', scope: 'decidim.devise.shared.password_fields' %>">
  <%= form.send(:custom_label, :password, t("activemodel.attributes.user.password"), {}) %>
  <p class="help-text" style="font-size: 0.875rem; color: #666;">
    <%= t("password_requirements", scope: "decidim.devise.shared.password_fields", default: "15 character minimum, must not be too common") %>
  </p>
  <%= form.password_field :password, autocomplete: "new-password", label: false, placeholder: "************", data: { test_selector: "account-password" } %>
</div>
