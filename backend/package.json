{
	"name": "euldt-participate-chatbot-be",
	"version": "1.0.0",
	"description": "BE Project of EU LDT Participate chatbot",
	"main": "build/src/server.js",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "nodemon --watch src src/server.ts",
		"start": "node build/src/server.js",
		"test": "jest --runInBand --verbose",
		"test-debug": "jest --runInBand --verbose --debug",
		"locust": "locust --config locust/locust.conf",
		"test:load": "npm run dev --env .env.test & npm run locust",
		"type-check": "tsc",
		"seed": "sequelize-cli --options-path=.sequelizerc.js db:seed:all",
		"migrate": "sequelize-cli --options-path=.sequelizerc.js db:migrate",
		"seed:undo": "sequelize-cli --options-path=.sequelizerc.js db:seed:undo:all",
		"seed:generate": "sequelize-cli --options-path=.sequelizerc.js seed:generate --name"
	},
	"dependencies": {
		"@anatine/zod-mock": "^3.14.0",
		"@faker-js/faker": "^9.7.0",
		"@fastify/autoload": "^6.3.0",
		"@fastify/cors": "^11.0.1",
		"@fastify/formbody": "^8.0.2",
		"@fastify/helmet": "^13.0.1",
		"@fastify/jwt": "^9.1.0",
		"@fastify/middie": "^9.0.3",
		"@fastify/passport": "^3.0.2",
		"@fastify/rate-limit": "^10.2.2",
		"@fastify/request-context": "^6.2.0",
		"@fastify/sensible": "^6.0.3",
		"@fastify/swagger": "^9.5.1",
		"@fastify/swagger-ui": "^5.2.2",
		"@fastify/under-pressure": "^9.0.3",
		"@ngneat/falso": "^7.3.0",
		"@types/axios": "^0.9.36",
		"@types/jest": "^29.5.14",
		"@types/lodash": "^4.17.16",
		"axios": "^1.11.0",
		"bcryptjs": "^3.0.2",
		"body-parser": "^2.2.0",
		"dotenv": "^16.5.0",
		"exceljs": "^4.4.0",
		"fastify": "^5.3.2",
		"fastify-cli": "^7.4.0",
		"fastify-healthcheck": "^5.1.0",
		"fastify-plugin": "^5.0.1",
		"fastify-type-provider-zod": "^4.0.2",
		"handlebars": "^4.7.8",
		"i18next": "^25.1.1",
		"i18next-fs-backend": "^2.6.0",
		"i18next-http-middleware": "^3.7.4",
		"ioredis": "^5.7.0",
		"jest": "^29.7.0",
		"joi": "^17.13.3",
		"jsdom": "^26.1.0",
		"nodemailer": "^7.0.2",
		"pg": "^8.15.6",
		"pg-hstore": "^2.3.4",
		"pino": "^9.6.0",
		"puppeteer": "^24.8.2",
		"reflect-metadata": "^0.2.2",
		"sequelize": "^6.37.7",
		"sequelize-typescript": "^2.1.6",
		"ts-jest": "^29.3.2",
		"umzug": "^3.8.2",
		"undici": "^7.8.0",
		"uuid": "^11.1.0",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@types/jsdom": "^21.1.7",
		"@types/node": "^22.15.16",
		"@types/validator": "^13.15.0",
		"husky": "^9.1.7",
		"jest-html-reporter": "^4.1.0",
		"jest-junit": "^16.0.0",
		"nodemon": "^3.1.10",
		"pino-pretty": "^13.0.0",
		"sequelize-cli": "^6.6.3",
		"sqlite3": "^5.1.7",
		"ts-node": "^10.9.2",
		"typescript": "~5.8.3"
	}
}
