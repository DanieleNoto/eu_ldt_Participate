					"editorMode": "code",
					"format": "table",
					"rawQuery": true,
					"rawSql": "SELECT \n  CASE \n    WHEN admin = true THEN 'Admins'\n    WHEN managed = true THEN 'Managed Users'\n    ELSE 'Regular Users'\n  END as user_type,\n  COUNT(*) as value\nFROM decidim_users \nWHERE deleted_at IS NULL AND type = 'Decidim::User'\nGROUP BY \n  CASE \n    WHEN admin = true THEN 'Admins'\n    WHEN managed = true THEN 'Managed Users'\n    ELSE 'Regular Users'\n  END;",
					"refId": "A"
				}
			],
