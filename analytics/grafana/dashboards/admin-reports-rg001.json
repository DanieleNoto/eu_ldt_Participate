			"targets": [
				{
					"datasource": {
						"type": "postgres",
						"uid": "decidim_postgres"
					},
					"editorMode": "code",
					"format": "time_series",
					"rawQuery": true,
					"rawSql": "WITH daily_activities AS (\n  SELECT \n    DATE_TRUNC('day', created_at) as time,\n    'New Users' as metric,\n    COUNT(*) as value\n  FROM decidim_users \n  WHERE deleted_at IS NULL AND type = 'Decidim::User' AND confirmed_at IS NOT NULL\n    AND created_at >= NOW() - INTERVAL '$time_range days'\n  GROUP BY DATE_TRUNC('day', created_at)\n  \n  UNION ALL\n  \n  SELECT \n    DATE_TRUNC('day', created_at) as time,\n    'New Proposals' as metric,\n    COUNT(*) as value\n  FROM decidim_proposals_proposals \n  WHERE deleted_at IS NULL AND created_at >= NOW() - INTERVAL '$time_range days'\n  GROUP BY DATE_TRUNC('day', created_at)\n  \n  UNION ALL\n  \n  SELECT \n    DATE_TRUNC('day', created_at) as time,\n    'New Comments' as metric,\n    COUNT(*) as value\n  FROM decidim_comments_comments \n  WHERE deleted_at IS NULL AND created_at >= NOW() - INTERVAL '$time_range days'\n  GROUP BY DATE_TRUNC('day', created_at)\n)\nSELECT time, metric, SUM(value) as value\nFROM daily_activities\nGROUP BY time, metric\nORDER BY time;",
					"refId": "A"
				}
			],
			"title": "Daily Activity Trends",
			"type": "timeseries"
		},
		{
			"datasource": {
