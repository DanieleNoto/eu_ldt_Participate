<% provide(:title, @map_visualization.name) %>
<% add_decidim_meta_tags(
  title: @map_visualization.name,
  description: @map_visualization.map_description,
  url: map_visualization_url(@map_visualization),
  resource: @map_visualization
) %>

<div style="padding: 2rem;">
  <section class="layout-main__section layout-main__heading">
    <div class="row mt-4">
      <div class="columns large-12">
            <%= link_to map_visualizations_path, class: "button button--sc small hollow" do %>
              ← <%= t("decidim.ldt_map_visualization.map_visualizations.show.back_to_list") %>
            <% end %>
      </div>
    </div>
    <div class="flex justify-center">
      <h1 class="title-decorator my-12"><%= @map_visualization.name %></h1>
    </div>

    <% embed_base = ENV.fetch("PV_EMBED_BASE_URL", "https://pv-int.ldttoolbox.app/embed/maps_visualisation") %>
    <% embed_url = "#{embed_base}/#{@map_visualization.map_id}?lng=#{I18n.locale}" %>

    <% if @map_visualization.description.present? %>
      <div class="editor-content mb-4">
        <%= simple_format(html_escape(@map_visualization.description)) %>
      </div>
    <% end %>

    <!-- Collapsable Map Disclaimer -->
    <div class="row" style="margin-bottom: 1.5rem;">
      <div class="columns large-12">
        <details style="border: 1px solid #ddd; border-radius: 4px; padding: 1rem;">
          <summary style="cursor: pointer; font-weight: bold; user-select: none;">
            ⚠️ <%= t("decidim.ldt_map_visualization.map_visualizations.show.disclaimer_title") %>
          </summary>
          <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid #ddd;">
            <p><%= t("decidim.ldt_map_visualization.map_visualizations.show.disclaimer_content") %></p>
          </div>
        </details>
      </div>
    </div>

    <div class="row">
      <div class="columns large-12">
        <div class="blog__image grow">
          <iframe
            src="<%= embed_url %>"
            style="width: 100%; height: 800px; border: none; border-radius: 4px;"
            allowfullscreen
            loading="lazy"
            title="<%= html_escape(@map_visualization.name) %>">
          </iframe>
        </div>
      </div>
    </div>

    <div class="row" style="margin-top: 2rem;">
      <div class="columns large-12">
        <div class="layout-author">
          <div class="flex items-center justify-between w-full">
            <% if @map_visualization.map_owner.present? %>
              <div class="flex flex-col">
                <div class="text-sm text-secondary">
                  <%= t("decidim.ldt_map_visualization.map_visualizations.show.owner") %>
                </div>
                <div class="font-semibold">
                  <%= @map_visualization.map_owner %>
                </div>
              </div>
            <% end %>

            <div class="flex flex-col">
              <div class="text-sm text-secondary">
                <%= t("decidim.ldt_map_visualization.map_visualizations.show.created_at") %>
              </div>
              <div class="font-semibold">
                <%= l @map_visualization.created_at, format: :decidim_short %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full map data JSON for debugging/advanced use -->
  <% if Rails.env.development? %>
    <section class="layout-main__section">
      <details>
        <summary style="cursor: pointer; font-weight: bold;">Debug: Raw Map Data</summary>
        <pre style="background: #f5f5f5; padding: 1rem; overflow-x: auto; font-size: 0.85rem; margin-top: 1rem;"><%= JSON.pretty_generate(@map_visualization.parsed_map_data) %></pre>
      </details>
    </section>
  <% end %>
</div>
