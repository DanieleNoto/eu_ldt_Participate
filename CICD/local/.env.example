#
# Fill the values and save as .env (without .example suffix) for local Kind deployment.
# Flow: cicd/local/deploy.sh → Kind cluster → pull/load images → Helm (values-local.yaml)
#
# Quick start:
#   cd cicd/local && cp .env.example .env && vim .env && ./deploy.sh up
#
# Legend:
#   [REQUIRED]    – must be set before deploying; no safe default exists
#   [k8s default] – pre-filled with a Kubernetes-internal service default
#   [prefilled]   – value copied from .env.dev.example (docker-compose reference)
#
# For detailed descriptions of each variable, see:
#   infrastructure/scripts/ENVIRONMENT_VARIABLES_DESCRIPTIONS.md

# ============================================================================
# KIND CLUSTER & HELM
# ============================================================================
NAMESPACE=participate
KIND_CLUSTER_NAME=participate-local
RELEASE_NAME=eu-ldt-participate
USE_LOCAL_IMAGES=false
IMAGE_PULL_POLICY=IfNotPresent
REGISTRY=euldtshared.azurecr.io
REPO_DECIDIM=eu-ldt-part-int
REPO_CHATBOT_BE=eu-ldt-chatbot-be-int
REPO_CHATBOT_FE=eu-ldt-chatbot-fe-int
REPO_MATOMO=matomo-custom
ACR_USERNAME=euldtshared
ACR_PASSWORD=
# Set true to create acr-secret and pull from registry inside the cluster (skip kind load)
ACR_ENABLED=false
HELM_WAIT=true
HELM_TIMEOUT=10m
# When USE_LOCAL_IMAGES=true, set full local image references:
# LOCAL_IMAGE_DECIDIM=eu-ldt-part-int:local
# LOCAL_IMAGE_CHATBOT_BE=eu-ldt-chatbot-be-int:local
# LOCAL_IMAGE_CHATBOT_FE=eu-ldt-chatbot-fe-int:local
# LOCAL_IMAGE_MATOMO=matomo-custom:local
JITSI_ENABLED=true

# ============================================================================
# DECIDIM APPLICATION
# ============================================================================
#   [prefilled from .env.dev.example]
CHATBOT_BACKEND_URL=http://localhost:3002
CHATBOT_URL=http://localhost:5001
DECIDIM_AVAILABLE_LOCALES=en,it,es
DECIDIM_DEFAULT_LOCALE=en
DECIDIM_HOST=localhost
# Local Kind: HTTP without TLS (port-forward / ingress on :80)
DECIDIM_FORCE_SSL=false
DECIDIM_PROTOCOL=http
DECIDIM_JITSI_URL=https://meet.jitsi
DECIDIM_THROTTLING_MAX_REQUESTS=60
GF_SERVER_DOMAIN=localhost
GF_SERVER_ROOT_URL=http://localhost:3001
MATOMO_SERVER_ADDRESS=http://localhost:8081
MATOMO_SITE_ID=1
MEETINGS_EMBEDDABLE_SERVICES="www.youtube.com www.twitch.tv meet.jit.si our-jitsi-link.ldt localhost"
POSTGRES_DATABASE=decidim_production
RAILS_LOG_LEVEL=info
SMTP_AUTHENTICATION=plain
SMTP_DOMAIN=example.com
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPEN_TIMEOUT=10
SMTP_PORT=587
SMTP_READ_TIMEOUT=10
SMTP_TLS=false
TOOL0_API_TOOLBAR_APPLICATIONS=/api/dashboard/applications/external-tools

#   [k8s default]
DATABASE_HOST_DECIDIM=db
ENABLE_JSON_LOGS=true
KEYCLOAK_DISABLE_SSL_VERIFY=false
QUEUE_ADAPTER=sidekiq
REDIS_URL=redis://redis:6379/0
RESTART_POLICY=always

#   [REQUIRED]
#     Docker image tag to deploy (e.g. git tag v1.0.0)
CONTAINER_IMAGE_TOOL_TAG=49135
#     PostgreSQL database name for Decidim
DATABASE_NAME_DECIDIM=decidim_application_development
#     PostgreSQL password for the Decidim database
DATABASE_PASSWORD_DECIDIM=postgres
#     Full Postgres DSN — leave empty to auto-build from host/user/pass/name above
DATABASE_URL_DECIDIM=postgres://postgres:postgres@db:5432/decidim_application_development
#     PostgreSQL user for the Decidim database
DATABASE_USERNAME_DECIDIM=postgres
#     From address for Decidim notification emails (e.g. noreply@example.com)
DECIDIM_MAILER_SENDER=
#     Help documentation URL
HELP_URL=
#     Matomo API authentication token
MATOMO_TOKEN_AUTH=
#     Keycloak OAuth2 client ID for Decidim
OMNIAUTH_KEYCLOAK_CLIENT_ID=tool3
#     Keycloak OAuth2 client secret for Decidim
OMNIAUTH_KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_ACTUAL_SECRET
#     Keycloak realm name
OMNIAUTH_KEYCLOAK_REALM=LDT
#     Keycloak base URL (e.g. https://keycloak.example.com)
OMNIAUTH_KEYCLOAK_SITE=
#     Rails secret key — generate with: openssl rand -hex 64
SECRET_KEY_BASE=
#     SMTP server hostname (e.g. smtp.example.com)
SMTP_ADDRESS=
#     SMTP account password
SMTP_PASSWORD=
#     SMTP account username
SMTP_USERNAME=
#     External tool 0 domain URL
TOOL0_DOMAIN=https://domain-placeholder
#     External tool 0 full URL
TOOL0_FULL_URL=https://domain-placeholder/api/dashboard/applications/external-tools
#     External tool 1 maps URL
TOOL1_MAPS_URL=https://domain-placeholder/api/maps
#     External tool 2 experiments URL
TOOL2_EXPERIMENTS_URL=https://domain-placeholder/api/v1/experiments
#     External tool 2 iframe URL
TOOL2_IFRAME_URL=https://domain-placeholder/embed/experiment-execution

RAILS_ASSET_HOST=

# ============================================================================
# CHATBOT BACKEND
# ============================================================================
#   [prefilled from .env.dev.example]
CHATBOT_FROM_EMAIL=chatbot@example.com
CHATBOT_SUPPORT_EMAIL=support@example.com
CORS_ORIGINS=http://localhost:5001,http://localhost:3000,http://localhost:3001
DECIDIM_LOGO_URL=/images/logo.png
DECIDIM_ORGANIZATION_NAME="EU LDT Participate"
DECIDIM_PRIMARY_COLOR="#0076d0"

#   [k8s default]
MAX_EVENT_LOOP_USE=0.98
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW="1 minute"

#   [REQUIRED]
#     Encryption salt for chatbot backend (random string)
CYPHER_SALT=
#     Encryption secret for chatbot backend (random string)
CYPHER_SECRET=
#     Full Postgres DSN for chatbot backend
DATABASE_URL_CHATBOT=
#     PostgreSQL database name for the chatbot backend
DB_NAME_CHATBOT=
#     PostgreSQL password for the chatbot backend database
DB_PASSWORD_CHATBOT=
#     PostgreSQL user for the chatbot backend database
DB_USERNAME_CHATBOT=
#     SMTP account username (alias used by some services)
SMTP_USER_NAME=

NOTIFICATION_PREFERENCES_URL=https://part-int.ldttoolbox.test/notifications/settings
PRIVACY_POLICY_URL=https://part-int.ldttoolbox.test/pages/terms-and-conditions

# ============================================================================
# CHATBOT FRONTEND
# ============================================================================
#   [prefilled from .env.dev.example]
VITE_API_URL=http://localhost:3002/api/v1

# ============================================================================
# GRAFANA
# ============================================================================
#   [prefilled from .env.dev.example]
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_EMAIL_ATTRIBUTE_PATH=email
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH=groups
GF_AUTH_GENERIC_OAUTH_LOGIN_ATTRIBUTE_PATH=username
GF_AUTH_GENERIC_OAUTH_NAME=Keycloak-OAuth
GF_AUTH_GENERIC_OAUTH_NAME_ATTRIBUTE_PATH=full_name
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH="contains(roles[*], 'admin') && 'Admin' || contains(roles[*], 'editor') && 'Editor' || 'Viewer'"
GF_AUTH_GENERIC_OAUTH_SCOPES="openid email profile offline_access roles"
GF_DATABASE_NAME=postgres
GF_DATABASE_USER=postgres
GF_SECURITY_ADMIN_USER=admin
GF_SERVER_SERVE_FROM_SUB_PATH=false

#   [k8s default]
GF_DATABASE_HOST=grafana-db
GF_DATABASE_TYPE=postgres
GRAFANA_PGDATA_PATH=/var/lib/postgresql/data/pgdata

#   [REQUIRED]
#     Keycloak userinfo endpoint URL
GF_AUTH_GENERIC_OAUTH_API_URL=https://im-int.ldttoolbox.app/realms/LDT/protocol/openid-connect/userinfo
#     Keycloak authorization endpoint URL
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://im-int.ldttoolbox.app/realms/LDT/protocol/openid-connect/auth
#     Keycloak OAuth2 client ID for Grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=
#     Keycloak OAuth2 client secret for Grafana
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=
#     Keycloak post-logout redirect URL
GF_AUTH_GENERIC_OAUTH_SIGNOUT_REDIRECT_URL=https://im-int.ldttoolbox.app/realms/LDT/protocol/openid-connect/logout?post_logout_redirect_uri=https%3A%2F%2Fpart-int.ldttoolbox.test%2Fanalytics%2Fgrafana%2Flogin
#     Keycloak token endpoint URL
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://im-int.ldttoolbox.app/realms/LDT/protocol/openid-connect/token
#     PostgreSQL password for the Grafana database
GF_DATABASE_PASSWORD=
#     Grafana admin account password
GF_SECURITY_ADMIN_PASSWORD=

# ============================================================================
# MATOMO
# ============================================================================
#   [prefilled from .env.dev.example]
MATOMO_DATABASE_DBNAME=matomo
MATOMO_DATABASE_USERNAME=matomo
MATOMO_ROOT_URL=http://matomo
MATOMO_TRUSTED_HOST=localhost
MYSQL_DATABASE=matomo
MYSQL_USER=matomo

#   [k8s default]
MATOMO_DATABASE_HOST=matomo-db-svc

#   [REQUIRED]
#     MariaDB password for Matomo
MATOMO_DATABASE_PASSWORD=matomopw
#     MariaDB password for the Matomo DB user
MYSQL_PASSWORD=matomo
#     MariaDB root password for Matomo DB
MYSQL_ROOT_PASSWORD=matomo

# ============================================================================
# JITSI
# ============================================================================
#   [prefilled from .env.dev.example]
JVB_STUN_SERVERS=stun.l.google.com:19302,stun1.l.google.com:19302
JWT_ACCEPTED_AUDIENCES=decidim
JWT_ACCEPTED_ISSUERS=decidim
JWT_APP_ID=decidim_app

#   [prefilled for local Kind — change in production]
#     Jitsi Focus Component auth password
JICOFO_AUTH_PASSWORD=localdev-jicofo-pass
#     Jitsi Video Bridge auth password
JVB_AUTH_PASSWORD=localdev-jvb-pass
#     JWT secret shared between Decidim and Jitsi
JWT_APP_SECRET=localdev-jwt-secret
#     Full public URL for Jitsi (e.g. https://jitsi.example.com)
PUBLIC_URL=

# ============================================================================
# INGRESS / PROXY
# ============================================================================
#   [REQUIRED]
#     Public hostname for Jitsi (e.g. jitsi.example.com)
JITSI_HOST=jitsi.participate.local
#     Public hostname for the Participate platform (e.g. participate.example.com)
PARTICIPATE_HOST=participate.local
