<%#
  FIX: Pre-initialize consent_cookie_name to prevent "undefined" cookie issue.
  The data_consent module initializes on DOMContentLoaded and reads consent_cookie_name
  from Decidim.config. However, Decidim.config.set() is called at the end of the body
  in _js_configuration.html.erb. This race condition can cause the cookie name to be
  "undefined" if the config isn't set when DOMContentLoaded fires.
  By setting the consent_cookie_name early in the head (after decidim_core.js loads but
  before DOMContentLoaded), we ensure it's always available.
%>
<script>
  // Early initialization of consent_cookie_name to prevent undefined cookie
  // This runs synchronously after decidim_core.js has loaded (due to position in head)
  (function() {
    var correctCookieName = '<%= Decidim.consent_cookie_name %>';

    // Clean up any existing "undefined" cookie (from previous bug)
    function deleteUndefinedCookie() {
      var cookies = document.cookie.split(';');
      for (var i = 0; i < cookies.length; i++) {
        var cookie = cookies[i].trim();
        if (cookie.indexOf('undefined=') === 0) {
          // Delete the undefined cookie from all possible paths/domains
          document.cookie = 'undefined=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
          document.cookie = 'undefined=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + window.location.hostname + ';';
          document.cookie = 'undefined=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=.' + window.location.hostname + ';';
          // Also try with parent domain
          var hostParts = window.location.hostname.split('.');
          if (hostParts.length >= 2) {
            var parentDomain = '.' + hostParts.slice(-2).join('.');
            document.cookie = 'undefined=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/; domain=' + parentDomain + ';';
          }
          console.debug('[Cookie Fix] Removed invalid "undefined" cookie');
        }
      }
    }

    // Delete undefined cookie immediately
    deleteUndefinedCookie();

    // Wait for Decidim to be available (it's set by decidim_core.js which loads with defer: false)
    var checkDecidim = function() {
      if (window.Decidim && window.Decidim.config) {
        var currentName = window.Decidim.config.get('consent_cookie_name');
        if (!currentName) {
          window.Decidim.config.set('consent_cookie_name', correctCookieName);
          console.debug('[Cookie Fix] Pre-initialized consent_cookie_name to:', correctCookieName);
        }
      } else {
        // Decidim not ready yet, check again in a moment
        setTimeout(checkDecidim, 1);
      }
    };
    checkDecidim();
  })();
</script>

<%= render partial: "layouts/decidim/matomo" %>
